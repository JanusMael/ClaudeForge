<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <RootNamespace>Bennewitz.Ninja.LayeredEditors.Avalonia.Tests</RootNamespace>
    </PropertyGroup>

    <!-- The solution's friend grants, in one shared file next to the .slnx. LINKED, not
         copied, by a relative path with forward slashes so Linux and macOS resolve it the
         same way Windows does. Read that file before adding a name: it is compiled into
         every assembly, so a grant there applies to all of them. -->
    <ItemGroup>
        <Compile Include="../../AssemblyInfo.InternalsVisibleTo.cs" Link="Properties/AssemblyInfo.InternalsVisibleTo.cs"/>
    </ItemGroup>

    <!-- The headless session bootstrap and its guard are LINKED, never copied, for the same
         reason as the friend grants above: one file that is obviously complete beats one per
         project. HeadlessSessionBootstrap builds the Avalonia application in [AssemblyInitialize]
         instead of leaving it to whichever test dispatches first; read its remarks before
         touching it, and only link it into a project that has an [AvaloniaTestApplication]. -->
    <ItemGroup>
        <Compile Include="../../HeadlessSessionBootstrap.cs" Link="Headless/HeadlessSessionBootstrap.cs"/>
        <Compile Include="../../HeadlessSessionBootstrapTests.cs" Link="Headless/HeadlessSessionBootstrapTests.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\LayeredEditors.Abstractions\LayeredEditors.Abstractions.csproj"/>
        <ProjectReference Include="..\..\src\LayeredEditors.Avalonia\LayeredEditors.Avalonia.csproj"/>
    </ItemGroup>
</Project>
