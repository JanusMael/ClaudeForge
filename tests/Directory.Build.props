<Project>
    <!-- MSBuild applies only the CLOSEST Directory.Build.props by default.
         To inherit the repo-root settings (Nullable, LangVersion, AutoVersioning,
         debug-type policy, etc.) on top of the test-only additions below, the
         root file must be explicitly imported.  GetPathOfFileAbove walks up
         the directory tree to find the next Directory.Build.props above this
         one — at the repo root, in this case. -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <!-- Test projects never get packed as NuGets; suppress the per-project
             redundant declarations. -->
        <IsPackable>false</IsPackable>
        <!-- xUnit v3 on Microsoft.Testing.Platform, selected for `dotnet test` by global.json
             (plans/00006). Each test project is an executable that hosts its own runner. Without
             this property an xunit.v3 executable runs xUnit's NATIVE console runner, which does
             not know `report-trx` — so CI would get no .trx files. -->
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <!-- ⓘ xUnit1051 ("pass TestContext.Current.CancellationToken") is ENFORCED. It was suppressed
             through the MSTest move (plans/00006 decision 5: no test rewrites mid-move), then applied
             to all 469 sites at once by Bennewitz.Ninja.Templates' scripts/xunit1051-fix.cs, because
             xUnit's own fixer cannot Fix All and `dotnet format` changes nothing. A new call that
             takes a token and is not given the test's fails the build (warnings are errors, root props). -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <!-- ⚠ Keep on xunit.v3's Microsoft.Testing.Platform line (1.9.x for 3.2.2). A newer
             TrxReport pins the platform above what xunit's bundled MSBuild extension can load,
             and the failure reads as an unrelated loader error (measured by the peers). -->
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1" />
        <!-- FakeTimeProvider: a clock tests advance by hand, so anything on a
             TimeProvider (StatusController's auto-clear) is deterministic without
             sleeping or pumping a dispatcher. -->
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
        <!-- MessageAssert (a converted assertion keeps its message), OrdinalAssert (a converted
             string assertion keeps MSTest's ORDINAL comparison) and the DoNotParallelize collection.
             ONE emitted file, linked into every test project, so the helpers and the rules that call
             them always come from one converter commit. Regenerate it with the converter's
             `emit-helpers` (Bennewitz.Ninja.Templates scripts/mstest-to-xunit.cs); never edit it
             by hand. New tests use xUnit's Assert directly. -->
        <Compile Include="$(MSBuildThisFileDirectory)Shared/MessageAssert.cs" Link="Shared/MessageAssert.cs" />
        <Using Include="Bennewitz.Ninja.Testing" />
    </ItemGroup>

</Project>
