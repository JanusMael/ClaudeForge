<Project>
    <!-- MSBuild applies only the CLOSEST Directory.Build.props by default.
         To inherit the repo-root settings (Nullable, LangVersion, AutoVersioning,
         debug-type policy, etc.) on top of the test-only additions below, the
         root file must be explicitly imported.  GetPathOfFileAbove walks up
         the directory tree to find the next Directory.Build.props above this
         one — at the repo root, in this case. -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <!-- Test projects never get packed as NuGets; suppress the per-project
             redundant declarations. -->
        <IsPackable>false</IsPackable>
        <!-- Microsoft.Testing.Platform, selected for `dotnet test` by global.json. Each test
             project is an executable that hosts its own runner (plans/00006 step 1). -->
        <EnableMSTestRunner>true</EnableMSTestRunner>
    </PropertyGroup>

    <ItemGroup>
        <!-- Test framework + coverage tooling — applied to every project under tests/.
             Previously duplicated across all 5 test csprojs. -->
        <PackageReference Include="MSTest" Version="4.3.3" />
        <!-- FakeTimeProvider: a clock tests advance by hand, so anything on a
             TimeProvider (StatusController's auto-clear) is deterministic without
             sleeping or pumping a dispatcher. -->
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
        <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.7.0" />
        <PackageReference Update="coverlet.collector" Version="10.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
