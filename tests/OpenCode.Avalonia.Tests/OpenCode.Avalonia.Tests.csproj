<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <RootNamespace>Bennewitz.Ninja.OpenCode.Avalonia.Tests</RootNamespace>
    </PropertyGroup>

    <!-- The solution's friend grants, in one shared file next to the .slnx. LINKED, not
         copied, by a relative path with forward slashes so Linux and macOS resolve it the
         same way Windows does. Read that file before adding a name: it is compiled into
         every assembly, so a grant there applies to all of them. -->
    <ItemGroup>
        <Compile Include="../../AssemblyInfo.InternalsVisibleTo.cs" Link="Properties/AssemblyInfo.InternalsVisibleTo.cs"/>
    </ItemGroup>

    <ItemGroup>
        <!-- OpenCode.Sdk and the shell's currency types arrive transitively, which is what lets
             these tests assert the editor's value against OrderedPropertyMap and drive the same
             OpenCodePermissionModel the config loader uses.

             No Avalonia.Headless: nothing here constructs a view. The view-models are plain
             ObservableObjects, and headless sessions are serial-only across the whole suite —
             paying that cost for tests that never touch a control would be a poor trade. See
             tests/ClaudeForge.Tests/Headless/ for the cases that genuinely need it. -->
        <ProjectReference Include="..\..\src\OpenCode.Avalonia\OpenCode.Avalonia.csproj"/>
    </ItemGroup>
</Project>
