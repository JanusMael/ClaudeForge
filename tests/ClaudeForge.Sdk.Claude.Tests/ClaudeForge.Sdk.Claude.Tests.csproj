<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Bennewitz.Ninja.ClaudeForge.Sdk.Claude.Tests</RootNamespace>
    </PropertyGroup>

    <!-- The solution's friend grants, in one shared file next to the .slnx. LINKED, not
         copied, by a relative path with forward slashes so Linux and macOS resolve it the
         same way Windows does. Read that file before adding a name: it is compiled into
         every assembly, so a grant there applies to all of them. -->
    <ItemGroup>
        <Compile Include="../../AssemblyInfo.InternalsVisibleTo.cs" Link="Properties/AssemblyInfo.InternalsVisibleTo.cs"/>
    </ItemGroup>

    <ItemGroup>
        <!-- AgentForge.Sdk and AgentForge.Core come in transitively, so tests here
             can reach the neutral client machinery and Core types they assert
             against (SettingsWorkspace, SchemaRegistry). -->
        <ProjectReference Include="..\..\src\ClaudeForge.Sdk.Claude\ClaudeForge.Sdk.Claude.csproj"/>
    </ItemGroup>

    <!--
        The frozen Claude backup archive, restored by BackupArchiveCompatibilityTests. It moved
        here from AgentForge.Core.Tests byte-for-byte (plans/00008 decision 6), because it restores
        into Claude's paths with Claude's descriptors.

        ⛔ A BINARY FIXTURE that must never be regenerated to make a test pass. It was minted by
        the shipped engine at a known layout; regenerating it against a changed layout makes it
        round-trip with itself and proves nothing.
    -->
    <ItemGroup>
        <Content Include="Fixtures\**\*.zip" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
