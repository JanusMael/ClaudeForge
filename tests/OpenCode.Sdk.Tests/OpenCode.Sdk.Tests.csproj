<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <RootNamespace>Bennewitz.Ninja.OpenCode.Sdk.Tests</RootNamespace>
    </PropertyGroup>

    <!-- The solution's friend grants, in one shared file next to the .slnx. LINKED, not
         copied, by a relative path with forward slashes so Linux and macOS resolve it the
         same way Windows does. Read that file before adding a name: it is compiled into
         every assembly, so a grant there applies to all of them. -->
    <ItemGroup>
        <Compile Include="../../AssemblyInfo.InternalsVisibleTo.cs" Link="Properties/AssemblyInfo.InternalsVisibleTo.cs"/>
    </ItemGroup>

    <ItemGroup>
        <!-- AgentForge.Sdk and AgentForge.Core arrive transitively, so tests here reach the
             neutral client machinery (ScopeLadder, SettingsWorkspace, SchemaRegistry) they
             assert OpenCode's implementations against. Mirrors ClaudeForge.Sdk.Claude.Tests. -->
        <ProjectReference Include="..\..\src\OpenCode.Sdk\OpenCode.Sdk.csproj"/>
    </ItemGroup>
</Project>
