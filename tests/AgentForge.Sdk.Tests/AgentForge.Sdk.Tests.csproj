<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <UseXunitV3>true</UseXunitV3>
        <RootNamespace>Bennewitz.Ninja.AgentForge.Sdk.Tests</RootNamespace>
    </PropertyGroup>

    <!-- The solution's friend grants, in one shared file next to the .slnx. LINKED, not
         copied, by a relative path with forward slashes so Linux and macOS resolve it the
         same way Windows does. Read that file before adding a name: it is compiled into
         every assembly, so a grant there applies to all of them. -->
    <ItemGroup>
        <Compile Include="../../AssemblyInfo.InternalsVisibleTo.cs" Link="Properties/AssemblyInfo.InternalsVisibleTo.cs"/>
    </ItemGroup>

    <ItemGroup>
        <!-- AgentForge.Sdk → AgentForge.Core is transitive, so the Sdk tests
             can also reach Core types like AgentForge.Core.Backup.JsonRedactor.
             The cross-project parity test (SensitiveKeysParityTests) exercises
             both classifiers in a single suite. -->
        <ProjectReference Include="..\..\src\AgentForge.Sdk\AgentForge.Sdk.csproj"/>
        <!-- Deliberately NO reference to any ClaudeForge.* project. This project
             tests the product-neutral SDK, so it must be buildable without either
             product; tests that need a live client use the local TestConfigClient.
             Claude-domain tests live in tests/ClaudeForge.Sdk.Claude.Tests. -->
    </ItemGroup>
</Project>
