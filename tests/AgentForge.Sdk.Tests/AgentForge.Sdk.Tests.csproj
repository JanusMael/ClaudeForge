<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <RootNamespace>Bennewitz.Ninja.AgentForge.Sdk.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- AgentForge.Sdk → AgentForge.Core is transitive, so the Sdk tests
             can also reach Core types like AgentForge.Core.Backup.JsonRedactor.
             The cross-project parity test (SensitiveKeysParityTests) exercises
             both classifiers in a single suite. -->
        <ProjectReference Include="..\..\src\AgentForge.Sdk\AgentForge.Sdk.csproj"/>
        <!-- TRANSITIONAL: the Claude-domain tests in this project have not moved to
             ClaudeForge.Sdk.Claude.Tests yet. A project named AgentForge.* must not
             depend on a product; this reference goes away with that move. -->
        <ProjectReference Include="..\..\src\ClaudeForge.Sdk.Claude\ClaudeForge.Sdk.Claude.csproj"/>
    </ItemGroup>
</Project>
