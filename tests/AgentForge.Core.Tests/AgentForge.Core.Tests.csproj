<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Bennewitz.Ninja.AgentForge.Core.Tests</RootNamespace>
    </PropertyGroup>

    <!-- The solution's friend grants, in one shared file next to the .slnx. LINKED, not
         copied, by a relative path with forward slashes so Linux and macOS resolve it the
         same way Windows does. Read that file before adding a name: it is compiled into
         every assembly, so a grant there applies to all of them. -->
    <ItemGroup>
        <Compile Include="../../AssemblyInfo.InternalsVisibleTo.cs" Link="Properties/AssemblyInfo.InternalsVisibleTo.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\AgentForge.Core\AgentForge.Core.csproj"/>
    </ItemGroup>

    <!--
        ConfigFileWatcherFailureTests drives ConfigFileWatcher's poll through internals that the
        published packages at SharedPackageVersion 2026.3.925 do not contain, so in package mode
        (the published-version job) it cannot compile against that pin, and a test project that
        does not compile runs no test at all. KEYED ON THE PIN ITSELF: once the pin moves to a
        release that carries the poll, the file compiles in package mode again with no edit here,
        and a pin that moved without the poll fails the build on this file. The package canary
        packs this commit, so it compiles and runs the test throughout.
    -->
    <ItemGroup Condition="'$(UseSharedPackages)' == 'true' And '$(SharedPackageVersion)' == '2026.3.925'">
        <Compile Remove="FileIO/ConfigFileWatcherFailureTests.cs"/>
    </ItemGroup>

    <!--
        Frozen backup archives, restored by BackupArchiveCompatibilityTests.

        ⛔ These are BINARY FIXTURES and must never be regenerated to make a test pass. Each one
        was minted by the shipped engine at a known layout; regenerating one against a changed
        layout makes it round-trip with itself and proves nothing, which is exactly how a backup
        tool loses people's data.
    -->
    <ItemGroup>
        <Content Include="Fixtures\**\*.zip" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
