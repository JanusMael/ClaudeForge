<Project>

    <!--
      ══ The package version ══  (plans/00001, work item 3)

      One stamp, one source. AutoVersioning computes the version the assemblies carry and now
      also exposes it as a plain MSBuild property, readable before compilation; the eleven
      packages take their version from that same property, so a package and the assembly inside
      it agree BY CONSTRUCTION rather than by two conventions that happen to line up.

      ⛔ WHY NOT src/Directory.Build.props, WHERE THE REST OF THE PACKAGE IDENTITY LIVES.
      AutoPackageVersion is defined by the AutoVersioning package's own props, which arrive via
      the NuGet-generated import — AFTER Directory.Build.props. Assigned there it evaluates to
      EMPTY, and an empty PackageVersion does not fail: the SDK's default assignment has already
      run, so all eleven pack at 1.0.0 exactly as they did before. This file is imported last,
      which is the whole reason it is this file.

      ⚠ THE CONDITION IS NOT DEFENSIVE PADDING. Without it, a build in which AutoVersioning has
      not contributed its props — a `dotnet msbuild` on a project whose restore has not run —
      would assign the empty string and pack an unversioned package. Falling back to the SDK's
      default is the honest failure: 1.0.0 is visibly wrong, an empty version is a restore error
      from deep inside NuGet naming nothing the reader wrote down.

      ⓘ The canary passes -p:PackageVersion=<throwaway> on the command line. That is a GLOBAL
      property and outranks this assignment, which is what lets one script pack eleven packages
      at a per-run prerelease version without touching this file.

      PackageVersionLockstepTests reads the stamp back out of a BUILT DLL rather than out of the
      property that produced it — the property agreeing with itself proves nothing.
    -->
    <PropertyGroup Condition="'$(AutoPackageVersion)' != ''">
        <PackageVersion>$(AutoPackageVersion)</PackageVersion>
    </PropertyGroup>

    <!--
      ══ The shared-library reference switch ══  (plans/00001, work item 5)

      ProjectReference for development; PackageReference for the per-PR canary and the release
      publish. One conditional, applied centrally, so the two modes cannot be mixed.

      ⛔ MIXING THEM IS THE FAILURE THIS EXISTS TO MAKE UNREPRESENTABLE. ClaudeForge.Tests
      references src/AgentForge.Core AND src/ClaudeForge. If only the app switched, that test's
      graph would hold two AgentForge.Core.dll — one from a project, one transitively from a
      package — and MSBuild prefers the project output. A job named "package canary" would report
      success over a suite still exercising project-built code.

      ⭐ WHY THIS LIVES IN THE ROOT TARGETS FILE AND NOT A src/ ONE. It has to run AFTER each
      csproj declares its ProjectReferences, which rules out Directory.Build.props. The obvious
      answer — a Directory.Build.targets under src/ — is a trap measured while doing work item 2:
      MSBuild imports only the CLOSEST one, so adding it silently detaches every src project from
      THIS file, and the publish strip, the dead-resx guard and the raw-hex guard below all stop
      running with nothing failing.

      ⚠ WHICH REFERENCES SWITCH: those whose project file name begins `AgentForge.`, plus JsonC
      by name — a rule, not a list, and PackageMetadataTests asserts that the set it
      matches is exactly the set of packable projects. A reference to a PRODUCT-specific library
      (ClaudeForge.Sdk.Claude, OpenCode.Avalonia, …) stays a ProjectReference, because none of
      those is packaged.

      ⚠ WHICH PROJECTS SWITCH: every project that is not itself one of the eleven — both apps,
      all four product-specific libraries, the sample, and all twelve test projects. The eleven
      keep referencing EACH OTHER by project in both modes, which is what `IsPackable != true`
      expresses. ⓘ The plan says "both apps and all twelve test projects"; that list is
      incomplete. A product library left on ProjectReference re-creates the duplicate-assembly
      graph above through the app that references it, so it switches too.
    -->
    <PropertyGroup Condition="'$(UseSharedPackages)' == 'true' And '$(IsPackable)' != 'true'">
        <_SwitchSharedReferences>true</_SwitchSharedReferences>

        <!--
          ⛔ A PACKAGE AND A PROJECT DO NOT PUT THE SAME FILES IN THE OUTPUT DIRECTORY, and the
          canary is how that was found rather than reasoned about.

          A ProjectReference copies the referenced project's XML documentation file next to its
          DLL. A PackageReference does NOT: the SDK ships `lib/net10.0/*.xml` inside the .nupkg
          but leaves it there, because CopyDocumentationFilesFromPackages defaults to false.
          `PublicSurfaceContractTests.IAgentConfigClient_DocumentsThreadingContract` reads
          AgentForge.Sdk.xml from the test output to assert the threading contract is documented
          on the public interface, and it was the one test of 4,295 that failed in package mode.

          ⚠ Set only in this mode, on purpose. Repo-wide it would also drag every third-party
          package's XML into every bin/ directory — Avalonia's alone is megabytes — changing what
          development builds produce in order to fix something development builds do not have.
          Publish output is unaffected either way: the ExcludeNonDistributableFromPublish target
          below strips *.xml.
        -->
        <CopyDocumentationFilesFromPackages>true</CopyDocumentationFilesFromPackages>
    </PropertyGroup>

    <!--
      ⛔ TWO MSBUILD FACTS SHAPE EVERY LINE BELOW, both measured rather than recalled:

      1. `%(Metadata)` in a condition on an item OUTSIDE a target evaluates to EMPTY and does not
         error. The obvious spelling — Include="@(ProjectReference)" with a
         Condition="...StartsWith('AgentForge.')" — therefore matches nothing, silently, and the
         build succeeds having switched nothing. That was the first attempt here.
      2. Item `Remove` is a STRING comparison of item specs, not a path comparison. It does not
         normalise, `**` does not traverse `..`, and an absolute pattern will not match a
         relatively-spelled item. This repo spells these references two ways —
         `..\AgentForge.Core\…` from src/ and `..\..\src\AgentForge.Core\…` from tests/ — so a
         glob tuned to one spelling would silently miss the other. Which is the whole failure
         mode this file keeps running into.

      So: normalise every ProjectReference to its full path first, then use Remove as a SET
      DIFFERENCE, which is the one thing it does reliably. No per-item conditions, no target
      hooks — plain evaluation, so restore and build see identical items and cannot disagree.
    -->
    <ItemGroup Condition="'$(_SwitchSharedReferences)' == 'true'">
        <!-- The eleven, globbed off disk. Two family rules plus one exception, which is one
             more than anybody wants: JsonC is a general-purpose JSONC reader with no agent
             knowledge, so it was renamed out of the AgentForge family before first publish
             rather than carrying a name that overclaims. It is named here explicitly because
             it is a family of one. PackageMetadataTests asserts this set and the set of
             packable projects are the same set, in BOTH directions. -->
        <_PackableSharedProject Include="$(MSBuildThisFileDirectory)src\AgentForge.*\AgentForge.*.csproj" />
        <_PackableSharedProject Include="$(MSBuildThisFileDirectory)src\JsonC\JsonC.csproj" />

        <!-- Full paths, so Remove can match. The transform carries metadata across, so any
             PrivateAssets / OutputItemType on a reference survives the round trip. -->
        <_NormalisedProjectReference Include="@(ProjectReference->'%(FullPath)')" />

        <!-- Set difference, twice: what is NOT shared, then what IS. -->
        <_NonSharedProjectReference Include="@(_NormalisedProjectReference)" />
        <_NonSharedProjectReference Remove="@(_PackableSharedProject)" />

        <_SharedProjectReference Include="@(_NormalisedProjectReference)" />
        <_SharedProjectReference Remove="@(_NonSharedProjectReference)" />

        <!-- Product-specific references stay projects; the shared ones become packages. Only
             the ones this project actually referenced — adding all eleven everywhere would
             compile fine and hide a missing dependency. -->
        <ProjectReference Remove="@(ProjectReference)" />
        <ProjectReference Include="@(_NonSharedProjectReference)" />
        <PackageReference Include="@(_SharedProjectReference->'Bennewitz.Ninja.%(Filename)')"
                          Version="$(SharedPackageVersion)" />
    </ItemGroup>

    <!--
      ⚠ An empty version does not fail loudly on its own — it restores as NU1604 from deep inside
      NuGet, naming a package the reader never wrote down. Say what actually went wrong instead.
      The canary and release scripts always pass one; this catches a hand-typed
      `-p:UseSharedPackages=true`.
    -->
    <Target Name="ValidateSharedPackageVersion"
            BeforeTargets="CollectPackageReferences;BeforeBuild"
            Condition="'$(_SwitchSharedReferences)' == 'true' And '$(SharedPackageVersion)' == ''">
        <Error Text="UseSharedPackages=true needs SharedPackageVersion. It is the version of the eleven Bennewitz.Ninja.* packages to consume, and there is no safe default: falling back to the last-packed version would let a canary validate yesterday's build. Pack first and pass the same value: 'pwsh -NoProfile -File scripts/package-canary.ps1 -PackOnly' prints the version it packed. See plans/00001 work item 5." />
    </Target>

    <!--
      ⛔ THE RELEASE HAD NEVER ONCE BEEN BUILT FROM THE SHARED PACKAGES, and two comments said it
      was. `.github/workflows/ci.yml` and `scripts/package-canary.ps1` both called package mode
      "the mode the release publishes from" for the entire life of the feature; nothing set the
      switch, so every RID of every release ever cut used ProjectReference. plans/00003 exists for
      that defect, and this target is its Phase D guard. The claim used to live in a comment, and
      a comment is not a guard — so it is a build error now.

      ⚠ IT FIRES ON A LOCAL PUBLISH TOO, deliberately. `src/publish/publish.ps1` is the canonical
      entry point and the same script a developer runs; guarding CI alone would rebuild the exact
      local-versus-released divergence this plan closes.

      ⭐ THE HATCH IS NAMED AND RECORDED, never silent. `AllowProjectReferencePublish=true` takes
      the other path on purpose — the CI trim gate and the boot smoke both want a publish without
      feed credentials — and when it is used this target says so at high importance, so the line
      lands in the publish log `Publish-Rid.ps1` tees and in the provenance record it writes
      beside the archives. A publish that quietly took the other path while the release claimed
      package mode is this plan's founding defect pointed the other way.

      ⚠ A Message, not a Warning, and that is not a style choice. `Directory.Build.props` sets
      TreatWarningsAsErrors, and a hatch whose own record can be escalated into the failure it
      exists to avoid is not a hatch. Importance="high" survives the default verbosity that
      `Publish-Rid.ps1` and the CI logs run at.

      ⛔ PACKAGE MODE ANNOUNCES ITSELF TOO, and that line is not decoration. A guard that is
      SILENT on the good path leaves the log proving the mode only by the ABSENCE of the hatch
      line — which is exactly what a log looks like when the guard never ran at all, when the
      target was renamed, or when the condition stopped selecting this project. Absence is not
      evidence, and this repo has paid for treating it as evidence before. So every publish of a
      shipping app now states its mode positively, from any entry point including a bare
      `dotnet publish`, and the archived log can be read without re-deriving anything.

      ⚠ SCOPE IS DERIVED, NOT DECLARED. Every project under src/ is `Library` except the app, so
      OutputType plus `IsPackable != true` selects exactly the shipping apps — and picks up a
      second app automatically. An opt-in property would have to be remembered, and a new app that
      forgot it would publish unguarded, silently, which is the failure mode this file keeps
      meeting. Debug is excluded because a Debug publish ships nothing.
    -->
    <Target Name="GuardShippingPublishUsesPackages"
            BeforeTargets="PrepareForPublish"
            Condition="'$(Configuration)' == 'Release' And '$(OutputType)' != 'Library' And '$(IsPackable)' != 'true'">
        <Error Condition="'$(UseSharedPackages)' != 'true' And '$(AllowProjectReferencePublish)' != 'true'"
               Text="Release publish of $(MSBuildProjectName) with UseSharedPackages unset. The release must be built from the eleven Bennewitz.Ninja.* packages, not from ProjectReference: that claim lived in two comments and was false for every release ever cut (plans/00003). Pass -p:UseSharedPackages=true — SharedPackageVersion is the committed pin in the root Directory.Build.props, so it needs no other input. If this publish deliberately wants project references, as the CI trim gate and the boot smoke do because neither has feed credentials, pass -p:AllowProjectReferencePublish=true; it is recorded by name in the publish log and the provenance record. See plans/00003, Phase D step D3." />
        <Message Condition="'$(UseSharedPackages)' != 'true' And '$(AllowProjectReferencePublish)' == 'true'"
                 Importance="high"
                 Text="ESCAPE HATCH USED: AllowProjectReferencePublish=true. $(MSBuildProjectName) is publishing $(Configuration) from ProjectReference, NOT from the Bennewitz.Ninja.* packages. Recorded deliberately — plans/00003 D3 requires a departure from package mode to name itself. A shipping release must never take this path." />
        <Message Condition="'$(UseSharedPackages)' == 'true'"
                 Importance="high"
                 Text="PACKAGE MODE: $(MSBuildProjectName) is publishing $(Configuration) from the Bennewitz.Ninja.* packages at $(SharedPackageVersion). Stated positively on purpose — see the note above this target." />
    </Target>

    <!--
      Strip non-distributable files from the publish output.
  
      The publish output directory is the authoritative list of what goes into the
      distribution zip.  Two categories of files are excluded here so the script
      can zip whatever dotnet publish produces without any additional filtering:
  
      *.xml — XML documentation files produced by <GenerateDocumentationFile>true</>.
              Intentionally generated unconditionally (useful for IDE IntelliSense
              and dotnet pack), but not needed at runtime.
  
      *.pdb — PDB symbol files.
              In-tree project assemblies use DebugType=embedded (Directory.Build.props),
              so they produce no loose .pdb files at all.  The only .pdb files that
              reach the publish output come from native third-party NuGet packages
              (e.g. libSkiaSharp.pdb, libHarfBuzzSharp.pdb from SkiaSharp).  Those
              are native debug symbols; they serve no purpose for end users and should
              not appear in the distribution zip.
  
      Implementation notes:
      - ResolvedFileToPublish is the item list the SDK uses to copy files into the
        publish output folder.  Removing entries here suppresses the copy; the build
        output under bin/ is unaffected.
      - AfterTargets="ComputeFilesToPublish" runs after the SDK has populated
        ResolvedFileToPublish but before files are physically copied.
      - This file (Directory.Build.targets) is imported at the END of the SDK import
        chain, after all SDK targets are defined, which is why targets that hook into
        SDK targets via AfterTargets/BeforeTargets must live here and not in
        Directory.Build.props (which is imported at the beginning, before SDK targets
        exist).
    -->
    <Target Name="ExcludeNonDistributableFromPublish" AfterTargets="ComputeFilesToPublish">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                                   Condition="'%(Extension)' == '.xml' Or '%(Extension)' == '.pdb'"/>
        </ItemGroup>
    </Target>

    <!--
      Dead string-resource guard (build error).

      The C# compiler cannot flag an unused .resx key: its generated Strings.<Key>
      accessor is public, so the compiler never sees it as unused. This target is
      the build-time equivalent — for every project carrying a neutral
      Localization/Strings.resx, it asserts each key is referenced as
      Strings.<Key> somewhere in the project's own source OR the test projects,
      and emits a build error otherwise.

      Coverage is automatic: any project (today the app + ClaudeForge.Avalonia)
      that has Localization/Strings.resx is checked; no per-project opt-in.
      Scanning the project dir + the repo's tests/ keeps test-only references from
      false-positiving while never producing a false error (an unrelated match
      only marks a key "used"). Skipped on design-time (IDE) builds.

      Dynamic-access tripwire: the unused-key scan is only complete while every
      live key is referenced as the literal token Strings.<Key>. A by-name or
      reflective lookup (Strings.ResourceManager.GetString(variable),
      typeof(Strings) reflection) is invisible to it and could let a genuinely
      live key be reported "unused" and deleted. The task therefore also fails the
      build if those patterns appear in the project's OWN source (Strings.Designer.cs
      is excluded; tests/ is not scanned for this check, so reflective parity tests
      stay allowed). If a dynamically-built key family is ever genuinely needed,
      extend the task with an allowlist rather than removing the tripwire.
    -->
    <UsingTask TaskName="CheckUnusedResxKeys"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <ResxPath ParameterType="System.String" Required="true" />
            <ScanRoots ParameterType="System.String" Required="true" />
            <ProjectDir ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.IO;
using System.Linq;
using System.Text;
using System.Text.RegularExpressions;
using System.Xml.Linq;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public class CheckUnusedResxKeys : Task
{
    public string ResxPath { get; set; }
    public string ScanRoots { get; set; }
    public string ProjectDir { get; set; }

    public override bool Execute()
    {
        var keys = XDocument.Load(ResxPath).Root.Elements("data")
            .Select(d => (string)d.Attribute("name"))
            .Where(n => !string.IsNullOrEmpty(n))
            .ToList();

        var sep = Path.DirectorySeparatorChar;
        var files = new System.Collections.Generic.List<string>();
        foreach (var root in ScanRoots.Split(';'))
        {
            if (string.IsNullOrWhiteSpace(root) || !Directory.Exists(root)) continue;
            foreach (var f in Directory.EnumerateFiles(root, "*.*", SearchOption.AllDirectories))
            {
                bool ext = f.EndsWith(".cs", StringComparison.OrdinalIgnoreCase)
                           || f.EndsWith(".axaml", StringComparison.OrdinalIgnoreCase);
                if (!ext) continue;
                if (f.IndexOf(sep + "obj" + sep, StringComparison.OrdinalIgnoreCase) >= 0) continue;
                if (f.IndexOf(sep + "bin" + sep, StringComparison.OrdinalIgnoreCase) >= 0) continue;
                if (f.EndsWith("Strings.Designer.cs", StringComparison.OrdinalIgnoreCase)) continue;
                files.Add(f);
            }
        }

        // Build the usage corpus with non-code blanked so a Strings.<Key> that
        // appears ONLY in a comment (e.g. a <see cref="Strings.Foo"/> doc note)
        // does not keep a genuinely-dead key alive. C# files have their comments
        // blanked but string/char content (incl. $"...{Strings.Foo}..." holes) is
        // preserved, since those are real references. .axaml references live in
        // attribute values, so only XML comments are blanked there.
        var sb = new StringBuilder();
        foreach (var f in files)
        {
            string raw = File.ReadAllText(f);
            string forCorpus = f.EndsWith(".axaml", StringComparison.OrdinalIgnoreCase)
                ? StripXmlComments(raw)
                : StripComments(raw);
            sb.Append(forCorpus).Append('\n');
        }
        var corpus = sb.ToString();

        bool ok = true;

        // (1) Dead-key check: every neutral-resx key must appear as a literal
        //     Strings.<Key> reference in project source or the test projects.
        foreach (var k in keys)
        {
            if (!Regex.IsMatch(corpus, @"Strings\." + Regex.Escape(k) + @"\b"))
            {
                Log.LogError(
                    "Unused string resource '{0}' ({1}). Remove the <data> entry from the .resx " +
                    "(and the locale copies) plus its Strings.Designer.cs accessor, or reference it as Strings.{0}.",
                    k, Path.GetFileName(ResxPath));
                ok = false;
            }
        }

        // (2) Dynamic-access tripwire: forbid by-name / reflective resolution of
        //     the Strings class in the project's own source. Such patterns are
        //     invisible to (1) and could let a live key be reported unused and
        //     deleted. Scanned per-file (project dir only) so we can report a line
        //     and so reflective tests under tests/ stay allowed.
        var dynamicAccessPatterns = new[] { @"\bStrings\.ResourceManager\b", @"typeof\(\s*Strings\s*\)" };
        var projDir = string.IsNullOrEmpty(ProjectDir) ? null : ProjectDir.TrimEnd(sep);
        foreach (var f in files)
        {
            if (projDir != null && !f.StartsWith(projDir, StringComparison.OrdinalIgnoreCase)) continue;
            // Blank out comments + string literals (offsets/newlines preserved) so a
            // forbidden token mentioned in a doc comment or a string doesn't false-trip.
            string text = StripNonCode(File.ReadAllText(f));
            foreach (var pat in dynamicAccessPatterns)
            {
                Match m = Regex.Match(text, pat);
                if (!m.Success) continue;
                int line = 1;
                for (int i = 0; i < m.Index; i++) if (text[i] == '\n') line++;
                Log.LogError(
                    "Dynamic string-resource access '{0}' in {1}({2}). The dead-string guard only sees " +
                    "literal Strings.<Key> references, so by-name/reflective resolution can let a live key " +
                    "be reported unused and deleted. Use a literal Strings.<Key> accessor; if a " +
                    "dynamically-built key family is genuinely intended, extend this guard with an allowlist.",
                    m.Value, f, line);
                ok = false;
            }
        }

        return ok;
    }

    // ── Non-code stripping ──────────────────────────────────────────────────
    //
    // A single left-to-right tokenizer drives both blanking modes. Whichever
    // construct STARTS first at a given position wins, so a "//" inside a string
    // is not treated as a comment and a quote inside a // comment does not open a
    // phantom string — the bug a sequence of independent regex passes had. It
    // also understands char literals ('"' no longer opens a string), verbatim and
    // raw ("""…""") strings, and interpolation holes ($"…{code}…") whose contents
    // are real CODE and are scanned as such. Newlines and offsets are preserved
    // so reported line numbers stay correct.
    //
    //   StripComments  (blankStrings:false) — blank ONLY comments; keep all
    //     string/char content. Used for the dead-key corpus, where a
    //     Strings.<Key> inside an interpolated string is a real reference.
    //   StripNonCode   (blankStrings:true)  — also blank string/char literal
    //     TEXT, but still keep interpolation-hole code, so the dynamic-access
    //     tripwire catches Strings.ResourceManager used inside a hole while never
    //     false-tripping on a mention in plain comment/string text.

    private static string StripComments(string s) { return StripCore(s, false); }
    private static string StripNonCode(string s) { return StripCore(s, true); }

    private static char Blank(char c) { return (c == '\n' || c == '\r') ? c : ' '; }

    // Blank XML comments in .axaml (string-resource references live in attribute
    // values, so only <!-- … --> is removed).
    private static string StripXmlComments(string s)
    {
        return Regex.Replace(s, @"<!--[\s\S]*?-->", m =>
        {
            var sb = new StringBuilder(m.Length);
            foreach (char c in m.Value) sb.Append(Blank(c));
            return sb.ToString();
        });
    }

    private static string StripCore(string s, bool blankStrings)
    {
        var sb = new StringBuilder(s.Length);
        int i = 0;
        ScanCode(s, ref i, s.Length, sb, blankStrings, false);
        return sb.ToString();
    }

    // Scan a region of code. When inHole is true we are inside an interpolation
    // hole and must return (without consuming) at the matching unbalanced '}'.
    private static void ScanCode(string s, ref int i, int n, StringBuilder sb, bool blankStrings, bool inHole)
    {
        while (i < n)
        {
            char c = s[i];
            if (inHole && c == '}') return;

            if (c == '/' && i + 1 < n && s[i + 1] == '/')           // line comment
            {
                while (i < n && s[i] != '\n' && s[i] != '\r') { sb.Append(' '); i++; }
                continue;
            }
            if (c == '/' && i + 1 < n && s[i + 1] == '*')           // block comment
            {
                sb.Append("  "); i += 2;
                while (i < n && !(s[i] == '*' && i + 1 < n && s[i + 1] == '/')) { sb.Append(Blank(s[i])); i++; }
                if (i < n) { sb.Append("  "); i += 2; }
                continue;
            }
            if (c == '\'')                                          // char literal
            {
                sb.Append(blankStrings ? ' ' : c); i++;
                while (i < n)
                {
                    if (s[i] == '\\' && i + 1 < n)
                    {
                        if (blankStrings) sb.Append("  "); else { sb.Append(s[i]); sb.Append(s[i + 1]); }
                        i += 2; continue;
                    }
                    char d = s[i];
                    sb.Append(blankStrings ? Blank(d) : d); i++;
                    if (d == '\'') break;
                }
                continue;
            }
            if (c == '"' || c == '$' || c == '@')                  // possible string (with prefixes)
            {
                int j = i; int dollars = 0; bool at = false;
                while (j < n && (s[j] == '$' || s[j] == '@')) { if (s[j] == '$') dollars++; else at = true; j++; }
                if (j < n && s[j] == '"')
                {
                    int q = 0, k = j;
                    while (k < n && s[k] == '"') { q++; k++; }
                    for (int p = i; p < k; p++) sb.Append(blankStrings ? ' ' : s[p]); // prefix + opening quotes
                    i = k;
                    if (q >= 3) ScanRawStringBody(s, ref i, n, sb, blankStrings, q);
                    else if (q == 1) ScanStringBody(s, ref i, n, sb, blankStrings, at, dollars > 0);
                    // q == 2 is an empty "" / @"" / $"" string — already fully emitted.
                    continue;
                }
                sb.Append(c); i++; continue;                       // a lone $ or @ that isn't a string
            }

            sb.Append(c); i++;
        }
    }

    // Regular / verbatim / interpolated string body (single opening quote). The
    // closing quote is consumed. Interpolation holes are handed back to ScanCode.
    private static void ScanStringBody(string s, ref int i, int n, StringBuilder sb, bool blankStrings, bool verbatim, bool interp)
    {
        while (i < n)
        {
            char c = s[i];
            if (interp && c == '{')
            {
                if (i + 1 < n && s[i + 1] == '{') { sb.Append(blankStrings ? "  " : "{{"); i += 2; continue; }
                sb.Append('{'); i++;                               // structural brace
                ScanCode(s, ref i, n, sb, blankStrings, true);     // hole content is CODE
                if (i < n && s[i] == '}') { sb.Append('}'); i++; }
                continue;
            }
            if (interp && c == '}' && i + 1 < n && s[i + 1] == '}') { sb.Append(blankStrings ? "  " : "}}"); i += 2; continue; }
            if (!verbatim && c == '\\' && i + 1 < n)               // escape sequence
            {
                if (blankStrings) sb.Append("  "); else { sb.Append(c); sb.Append(s[i + 1]); }
                i += 2; continue;
            }
            if (c == '"')
            {
                if (verbatim && i + 1 < n && s[i + 1] == '"') { sb.Append(blankStrings ? "  " : "\"\""); i += 2; continue; }
                sb.Append(blankStrings ? ' ' : c); i++; return;    // closing quote
            }
            sb.Append(blankStrings ? Blank(c) : c); i++;
        }
    }

    // Raw string body: scan to the first run of >= q double-quotes (the closer).
    // Raw interpolation holes are not parsed — no Strings.<Key> is ever used in
    // one in this codebase, and the content is preserved in dead-key mode anyway.
    private static void ScanRawStringBody(string s, ref int i, int n, StringBuilder sb, bool blankStrings, int q)
    {
        while (i < n)
        {
            if (s[i] == '"')
            {
                int run = 0, k = i;
                while (k < n && s[k] == '"') { run++; k++; }
                for (int p = i; p < k; p++) sb.Append(blankStrings ? Blank(s[p]) : s[p]);
                i = k;
                if (run >= q) return;                              // closing delimiter
                continue;                                          // shorter run is literal content
            }
            sb.Append(blankStrings ? Blank(s[i]) : s[i]); i++;
        }
    }
}
]]></Code>
        </Task>
    </UsingTask>

    <!-- The publish scripts pass -p:RunResxKeyGuard=false (a global property that
         propagates to every project, including P2P references) to SKIP this guard during
         `dotnet publish`. The guard compiles an inline RoslynCodeTaskFactory task at build
         time; that generate-then-compile step can intermittently fail under concurrent
         builds / temp-dir contention (e.g. publishing from an IDE that also runs background
         builds), surfacing as a spurious "CheckUnusedResxKeys task was not found" plus a
         CS1002 on the generated temp source. It is a dev/CI guardrail (dead-key +
         dynamic-access tripwire) already enforced on every normal `dotnet build` and CI
         run, so it is not needed to produce a release binary. -->
    <Target Name="GuardUnusedResxKeys" AfterTargets="Build"
            Condition="'$(DesignTimeBuild)' != 'true'
                       And '$(RunResxKeyGuard)' != 'false'
                       And Exists('$(MSBuildProjectDirectory)/Localization/Strings.resx')">
        <CheckUnusedResxKeys ResxPath="$(MSBuildProjectDirectory)/Localization/Strings.resx"
                             ScanRoots="$(MSBuildProjectDirectory);$(MSBuildThisFileDirectory)tests"
                             ProjectDir="$(MSBuildProjectDirectory)" />
    </Target>

    <!--
        No raw hex colours in view-models.

        ⭐ SCOPED TO VIEW-MODELS ON PURPOSE, and the scope is what makes the rule enforceable.
        A repo-wide ban is unshippable: ~230 hex literals live in AXAML (App.axaml IS the token
        declaration) and 45 more in C#, essentially all of them legitimate — syntax colouring in
        JsonHighlightBlock, the scope and status brush converters, CodeInline, and every
        BrushHelper fallback, which exists precisely so a missing token still renders. Those are
        colour DEFINITIONS and resolution backstops. A view-model returning a colour is different
        in kind: it puts presentation in the layer that has no view, and it puts the value beyond
        the theme's reach in both variants at once.

        ⛔ This is not a style rule. The literal it was written to catch —
        SaveChangeEntryViewModel.KindBackground's #F57C00 — gave its white glyph 2.70:1, under
        both the 4.5:1 text floor and the 3.0:1 non-text one, and had a comment defending the
        choice on hue grounds with no contrast measurement anywhere. A colour nobody can see in
        the theme files is a colour nobody re-measures.

        Comments and string interpolation holes are stripped first: prose citing an old hex (see
        AppSeverity.cs) is documentation, not a colour decision.
    -->
    <UsingTask TaskName="CheckRawHexInViewModels"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <ProjectDir ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.IO;
using System.Linq;
using System.Text;
using System.Text.RegularExpressions;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public class CheckRawHexInViewModels : Task
{
    public string ProjectDir { get; set; }

    public override bool Execute()
    {
        if (!Directory.Exists(ProjectDir)) return true;

        // A quoted 3/4/6/8-digit hex colour — the form Avalonia parses from a bound string.
        var hex = new Regex("\"#(?:[0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})\"");
        var blockComment = new Regex(@"/\*.*?\*/", RegexOptions.Singleline);
        var lineComment = new Regex(@"//[^\r\n]*");
        var sep = Path.DirectorySeparatorChar;
        var offenders = new System.Collections.Generic.List<string>();

        foreach (var f in Directory.EnumerateFiles(ProjectDir, "*.cs", SearchOption.AllDirectories))
        {
            if (f.Contains(sep + "obj" + sep) || f.Contains(sep + "bin" + sep)) continue;

            var name = Path.GetFileName(f);
            bool isViewModel = name.EndsWith("ViewModel.cs", StringComparison.OrdinalIgnoreCase)
                               || f.Contains(sep + "ViewModels" + sep);
            if (!isViewModel) continue;

            var text = File.ReadAllText(f);
            text = blockComment.Replace(text, "");
            text = lineComment.Replace(text, "");

            foreach (Match m in hex.Matches(text))
            {
                var line = text.Take(m.Index).Count(c => c == '\n') + 1;
                offenders.Add(name + " ~line " + line + ": " + m.Value);
            }
        }

        if (offenders.Count == 0) return true;

        var sb = new StringBuilder();
        sb.Append("Raw hex colour(s) in view-model(s): ");
        sb.Append(string.Join("; ", offenders));
        sb.Append(". A view-model must not name a colour — declare an App*Brush token per theme ");
        sb.Append("variant in each app's App.axaml and bind through a converter over the enum ");
        sb.Append("(see ChangeKindToBrushConverter / AppSeverityToBrushConverter). A literal here ");
        sb.Append("is invisible to the theme and, in the case this guard was written for, shipped ");
        sb.Append("a 2.70:1 contrast failure. See docs/DANGER-TAXONOMY.md.");
        Log.LogError(sb.ToString());
        return false;
    }
}
]]></Code>
        </Task>
    </UsingTask>

    <Target Name="GuardRawHexInViewModels" AfterTargets="Build"
            Condition="'$(DesignTimeBuild)' != 'true'
                       And '$(RunRawHexGuard)' != 'false'">
        <CheckRawHexInViewModels ProjectDir="$(MSBuildProjectDirectory)" />
    </Target>

</Project>
