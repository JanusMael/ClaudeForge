<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <IsPackable>true</IsPackable>
        <RootNamespace>Bennewitz.Ninja.LayeredEditors.ViewModels</RootNamespace>
        <AssemblyName>LayeredEditors.ViewModels</AssemblyName>
        <Description>
            View-models for layered-scope settings editors — pure presentation logic with NO
            Avalonia (or any UI-framework) reference. Split out of LayeredEditors.Avalonia so a
            view-model can never construct an Avalonia control: the editors built off the UI
            thread during startup (MainWindowViewModel.BuildNavigationTreeAsync → BuildGroups)
            stay safe by construction — a control reference here is a compile error.
            Depends only on LayeredEditors.Abstractions + CommunityToolkit.Mvvm.
        </Description>
    </PropertyGroup>

    <!-- The solution's friend grants, in one shared file next to the .slnx. LINKED, not
         copied, by a relative path with forward slashes so Linux and macOS resolve it the
         same way Windows does. Read that file before adding a name: it is compiled into
         every assembly, so a grant there applies to all of them. -->
    <ItemGroup>
        <Compile Include="../../AssemblyInfo.InternalsVisibleTo.cs" Link="Properties/AssemblyInfo.InternalsVisibleTo.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LayeredEditors.Abstractions\LayeredEditors.Abstractions.csproj"/>
    </ItemGroup>
</Project>
