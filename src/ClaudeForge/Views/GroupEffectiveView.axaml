<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bennewitz.Ninja.ClaudeForge.ViewModels"
             xmlns:shell="using:Bennewitz.Ninja.AgentForge.Avalonia.Shell.Settings"
             xmlns:conv="using:Bennewitz.Ninja.ClaudeForge.Converters"
             xmlns:libconv="using:Bennewitz.Ninja.LayeredEditors.Avalonia.Converters"
             xmlns:controls="using:Bennewitz.Ninja.ClaudeForge.Controls"
             xmlns:loc="clr-namespace:Bennewitz.Ninja.ClaudeForge.Localization"
             x:Class="Bennewitz.Ninja.ClaudeForge.Views.GroupEffectiveView"
             x:DataType="shell:SettingsGroupEditorViewModel">

    <!-- Built-in "Effective" tab body: subtitle + merged-value grid (read-only).
         Extracted from SettingsGroupEditorView. DataContext = the group VM.
         Carries its own scope-chiclet converters (were in the parent's Resources). -->
    <UserControl.Resources>
        <conv:ScopeToBrushConverter x:Key="ScopeToBrush" />
        <conv:ScopeToDisplayNameConverter x:Key="ScopeToName" />
        <conv:ScopeToTooltipConverter x:Key="ScopeToTooltip" />
        <conv:LongValueTooltipConverter x:Key="LongValueTooltip" />
        <!-- Severity rendering, shared with both PropertyEditorWrappers so a tier looks the same
             wherever it appears. -->
        <libconv:AppSeverityToBrushConverter x:Key="SeverityToBrush" />
        <libconv:AppSeverityToGlyphConverter x:Key="SeverityToGlyph" />
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="14,8"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock Text="{x:Static loc:Strings.TextEffectiveTabSubtitle}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       MaxWidth="800"
                       HorizontalAlignment="Left"
                       TextAlignment="Left"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Border>

        <DataGrid ItemsSource="{Binding EffectiveRows}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  GridLinesVisibility="Horizontal"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  AutomationProperties.Name="{x:Static loc:Strings.AutoNameEffectiveRowsGrid}"
                  AutomationProperties.HelpText="{x:Static loc:Strings.AutoHelpEffectiveRowsGrid}">
            <DataGrid.Columns>
                <!--
                    Risk — first column so the weight is read before the label, matching the
                    property wrapper where the dot precedes the name.

                    ⭐⭐ This is assessed at the scope that WON and the value in effect, so it can
                    legitimately differ from the dot on the same setting in the Properties tab
                    (which assesses the scope you are editing). That divergence is the column's
                    reason to exist — see EffectivePropertyRow.Danger — and the header tooltip
                    says so, because two dots disagreeing otherwise reads as a bug.

                    Sortable on the enum, which is ordered least→most severe: one click on the
                    header brings every Critical row together.
                -->
                <DataGridTemplateColumn Width="Auto"
                                        CanUserSort="True"
                                        SortMemberPath="Danger.Severity">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{x:Static loc:Strings.HeaderEffectiveSeverity}"
                                   ToolTip.Tip="{x:Static loc:Strings.TipHeaderEffectiveSeverity}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="shell:EffectivePropertyRow">
                            <!-- Dual-coded: the GLYPH differs per tier (▲ ◆ ● ○) as well as the
                                 colour, because Critical-vs-Caution sits exactly on the red-green
                                 axis. Geometric shapes, not emoji — emoji need a system emoji
                                 font and render as tofu without one.

                                 ⛔ HelpText, not Name: on a TextBlock the Text always wins and an
                                 explicit Name is ignored outright, so a Name here would announce
                                 the glyph character and nothing else. -->
                            <TextBlock IsVisible="{Binding HasDangerSeverity}"
                                       Text="{Binding Danger.Severity, Converter={StaticResource SeverityToGlyph}}"
                                       Foreground="{Binding Danger.Severity, Converter={StaticResource SeverityToBrush}}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="12,0"
                                       AutomationProperties.HelpText="{Binding DangerAccessibleText}"
                                       ToolTip.Tip="{Binding DangerAccessibleText}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="200" CanUserSort="True" SortMemberPath="Property">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{x:Static loc:Strings.HeaderEffectiveProperty}"
                                   ToolTip.Tip="{x:Static loc:Strings.TipHeaderEffectiveProperty}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="shell:EffectivePropertyRow">
                            <!-- Tooltip shows the schema description (falls back to the name). -->
                            <controls:TipCell Tip="{Binding PropertyTooltip}">
                                <TextBlock Text="{Binding Property}"
                                           VerticalAlignment="Center"
                                           Margin="12,0"
                                           TextTrimming="CharacterEllipsis" />
                            </controls:TipCell>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="*" CanUserSort="True" SortMemberPath="DisplayValue">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{x:Static loc:Strings.HeaderEffectiveValue}"
                                   ToolTip.Tip="{x:Static loc:Strings.TipHeaderEffectiveValueCol}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="shell:EffectivePropertyRow">
                            <!-- Cell trims to width; hover pretty-prints the full JSON value. -->
                            <controls:TipCell Tip="{Binding DisplayValue, Converter={StaticResource LongValueTooltip}}">
                                <SelectableTextBlock Text="{Binding DisplayValue}"
                                                     TextTrimming="CharacterEllipsis"
                                                     VerticalAlignment="Center"
                                                     Margin="12,0" />
                            </controls:TipCell>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="Auto"
                                        CanUserSort="True"
                                        SortMemberPath="Scope">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{x:Static loc:Strings.HeaderEffectiveScope}"
                                   ToolTip.Tip="{x:Static loc:Strings.TipHeaderEffectiveScope}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="shell:EffectivePropertyRow">
                            <Border Background="{Binding Scope, Converter={StaticResource ScopeToBrush}}"
                                    TextElement.Foreground="White"
                                    CornerRadius="3" Padding="6,2" Margin="4,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding Scope, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    ToolTip.Tip="{Binding Scope, Converter={StaticResource ScopeToTooltip}}">
                                <TextBlock Text="{Binding Scope, Converter={StaticResource ScopeToName}}"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           ToolTip.Tip="{Binding Scope, Converter={StaticResource ScopeToTooltip}}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Binding="{Binding IsOverridden}" Width="90">
                    <DataGridCheckBoxColumn.Header>
                        <TextBlock Text="{x:Static loc:Strings.HeaderEffectiveOverridden}"
                                   ToolTip.Tip="{x:Static loc:Strings.TipHeaderEffectiveOverridden}" />
                    </DataGridCheckBoxColumn.Header>
                </DataGridCheckBoxColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
