<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Bennewitz.Ninja.ClaudeForge.Views"
        xmlns:app="using:Bennewitz.Ninja.ClaudeForge"
        xmlns:loc="clr-namespace:Bennewitz.Ninja.ClaudeForge.Localization"
        x:Class="Bennewitz.Ninja.ClaudeForge.Views.AboutDialog"
        x:DataType="views:AboutDialog"
        Title="{x:Static loc:Strings.MenuAbout}"
        Width="520"
        MinWidth="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!--
        About ClaudeForge modal.

        Currently shows app name, tagline, and version. The right-half
        "Resources" panel is intentionally a vertical StackPanel (rather
        than a one-line label) so future hyperlinks (documentation site,
        GitHub repo, release notes, license) can be appended one per row
        without re-architecting the layout. Each future link should be a
        small Button styled like a hyperlink, calling
        IShellLauncher.OpenUrlAsync — keeping clickable hit areas full
        width to match the bottom-bar version button precedent.
    -->
    <DockPanel>

        <!-- Bottom button bar -->
        <Border DockPanel.Dock="Bottom"
                Padding="14,10"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <!-- AutomationProperties.Name reuses Content's key — visible
                 label is the right screen-reader announcement. -->
            <Button Content="{x:Static loc:Strings.ButtonClose}"
                    HorizontalAlignment="Right"
                    MinWidth="80"
                    IsCancel="True"
                    IsDefault="True"
                    Click="OnCloseClick"
                    AutomationProperties.Name="{x:Static loc:Strings.ButtonClose}" />
        </Border>

        <!-- Body -->
        <Grid ColumnDefinitions="*,1,*"
              RowDefinitions="*"
              Margin="20,18">

            <!-- Left: app identity -->
            <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Top">
                <Image Source="{x:Static app:AppIcon.BitmapInstance}"
                       Width="48" Height="48"
                       HorizontalAlignment="Left"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                <TextBlock Text="{x:Static loc:Strings.LabelAboutAppName}"
                           FontSize="20" FontWeight="Bold" />
                <TextBlock Text="{x:Static loc:Strings.LabelAboutTagline}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <!-- Single TextBlock with Runs so the version label and the
                     version number share one line layout (and one baseline).
                     Two TextBlocks in a StackPanel each VerticalAlignment=Center
                     with different FontFamily (default vs Consolas) produces
                     visibly mis-aligned baselines because center-alignment uses
                     each TextBlock's BBox center and Consolas's ascender/descender
                     ratio differs from the system font's.  Inline Runs ride a
                     single text line so the glyphs sit on the same baseline
                     regardless of FontFamily. -->
                <TextBlock FontSize="11"
                           Margin="0,8,0,0"
                           VerticalAlignment="Center">
                    <Run Text="{x:Static loc:Strings.LabelAboutVersion}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <Run Text=" " />
                    <Run Text="{Binding AppVersion, Mode=OneTime}"
                         FontFamily="Consolas,Menlo,monospace" />
                </TextBlock>
                <!-- Copyright pulled from AssemblyCopyrightAttribute via runtime
                     reflection in AboutDialog.axaml.cs.  Hidden via
                     StringConverters.IsNotNullOrEmpty when the attribute is absent
                     (test hosts, design-time tooling) so the line collapses
                     cleanly rather than leaving a blank gap. -->
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Text="{Binding AppCopyright, Mode=OneTime}"
                           IsVisible="{Binding AppCopyright, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />

                <!-- 2026-05-29: explicit "Check for updates" row.
                     Placed directly under the version line so the
                     button is the obvious next thing to click after
                     reading the version.  Bypasses the auto-check
                     opt-out + the once-per-launch latch (the click
                     IS consent).  Result text appears inline below
                     the button after the check completes; an optional
                     "View release" hyperlink surfaces when an
                     UpdateAvailable result included an html_url.
                     IsEnabled=!IsCheckingForUpdate disables the
                     button mid-check so re-clicks queue cleanly. -->
                <StackPanel Spacing="4" Margin="0,8,0,0">
                    <Button Content="{x:Static loc:Strings.ButtonCheckForUpdates}"
                            Click="OnCheckForUpdatesClick"
                            IsEnabled="{Binding !IsCheckingForUpdate}"
                            Padding="10,4"
                            HorizontalAlignment="Left"
                            ToolTip.Tip="{x:Static loc:Strings.TipCheckForUpdates}"
                            AutomationProperties.Name="{x:Static loc:Strings.ButtonCheckForUpdates}" />
                    <TextBlock FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               IsVisible="{Binding HasUpdateCheckResult}"
                               Text="{Binding UpdateCheckResultText}" />
                    <Button Classes="link"
                            Content="{x:Static loc:Strings.ButtonUpdateBannerOpenRelease}"
                            Click="OnViewUpdateReleaseClick"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding UpdateCheckHasReleaseUrl}"
                            ToolTip.Tip="{Binding UpdateCheckReleaseUrl}"
                            AutomationProperties.Name="{x:Static loc:Strings.ButtonUpdateBannerOpenRelease}" />
                </StackPanel>

                <!-- "Check for schema updates" — the sibling of the app-update check above,
                     and placed here for that reason: both answer "am I running something
                     stale?", and a user who came to this dialog to check one is the user who
                     wants the other.

                     They are NOT the same check. This one re-fetches the JSON Schemas the
                     editors are built from (schemastore.org, opencode.ai); the one above
                     asks GitHub about the binary.

                     The whole row hides when the dialog was opened without a main window
                     behind it, because there is then nothing to refresh. -->
                <StackPanel Spacing="4" Margin="0,8,0,0" IsVisible="{Binding CanCheckSchemas}">
                    <Button Content="{x:Static loc:Strings.ButtonCheckForSchemaUpdates}"
                            Click="OnCheckForSchemaUpdatesClick"
                            IsEnabled="{Binding !IsCheckingSchemas}"
                            Padding="10,4"
                            HorizontalAlignment="Left"
                            ToolTip.Tip="{x:Static loc:Strings.TipCheckForSchemaUpdates}"
                            AutomationProperties.Name="{x:Static loc:Strings.ButtonCheckForSchemaUpdates}" />
                    <TextBlock FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               IsVisible="{Binding HasSchemaCheckResult}"
                               Text="{Binding SchemaCheckResultText}" />
                </StackPanel>
            </StackPanel>

            <!--
                No vertical separator here, deliberately.

                A 1px Border in this column stretched to the GRID's height, which is set by the
                taller column - the left one carries icon, title, description, version, copyright
                and two buttons, roughly twice the right. So the rule ran ~150px past the last
                right-hand button into empty space and read as a rendering artifact. Reported as
                "stray vertical line on the About dialog" 2026-09-14.

                The column's own 14px gutter already separates the two halves. Constraining the
                rule's height to the shorter column was the alternative and was rejected: it
                couples the two columns' layout to buy back a divider nobody asked for.
            -->

            <!--
                Right: resources panel.

                Append future <Button Classes="link" .../> rows here as they
                are added; the StackPanel grows vertically and
                SizeToContent="Height" on the Window absorbs the change.

                ⓘ This used to say the panel was "empty for now" with a single
                placeholder label. It has carried real links — GitHub Repository
                and Report an Issue — for some time; the comment outlived them.
            -->
            <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top">
                <TextBlock Text="{x:Static loc:Strings.HeadingAboutLinks}"
                           FontSize="13" FontWeight="SemiBold" />
                <Button Classes="link"
                        Content="{x:Static loc:Strings.LinkGitHubRepo}"
                        Click="OnGitHubClick"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="https://github.com/JanusMael/ClaudeForge"
                        AutomationProperties.Name="{x:Static loc:Strings.LinkGitHubRepo}" />
                <Button Classes="link"
                        Content="{x:Static loc:Strings.LinkReportIssue}"
                        Click="OnReportIssueClick"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="https://github.com/JanusMael/ClaudeForge/issues"
                        AutomationProperties.Name="{x:Static loc:Strings.LinkReportIssue}" />
            </StackPanel>

        </Grid>
    </DockPanel>
</Window>