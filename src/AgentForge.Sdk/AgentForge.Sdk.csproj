<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <RootNamespace>Bennewitz.Ninja.AgentForge.Sdk</RootNamespace>
        <AssemblyName>AgentForge.Sdk</AssemblyName>
        <!-- Generate XML documentation file so consumers see the threading and
             cancellation contracts that live on the public interface.  CS1591 is
             disabled because we don't require a doc comment on every member at
             this stub stage; the architectural contracts are what matter. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- Sdk depends on Core for the existing settings/backup/profile engines.
             The reverse must NOT be true — Core remains independent of Sdk so it
             can be used as primitives, and Sdk owns the public contract on top. -->
        <ProjectReference Include="..\AgentForge.Core\AgentForge.Core.csproj"/>
        <!-- Dialog primitives (DialogMessage, DialogCategory, DialogSegment*) live in
             AgentForge.Abstractions: they carry no product knowledge, and hosting
             libraries need them without taking a dependency on a Claude-specific SDK.
             SdkDialogs — the Claude-flavoured dialog factories — stays here. -->
        <ProjectReference Include="..\AgentForge.Abstractions\AgentForge.Abstractions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Test project needs the in-progress reflection-based surface checks
             (e.g. asserting every async method requires a non-defaulted CT). -->
        <InternalsVisibleTo Include="AgentForge.Sdk.Tests"/>

        <!-- The Claude SDK's tests assert round-trips by reading the raw stored node
             back via the internal GetScopeValue, and inspect the internal
             PreservedFields bags. Same test-seam grant as above, one project over. -->
        <InternalsVisibleTo Include="ClaudeForge.Sdk.Claude.Tests"/>

        <!-- The Claude-domain half of the SDK. Its accessors project the workspace
             through GetEffectiveNode / GetScopeValue and report mutations through
             RaiseChangedFromAccessor, all of which are internal deliberately: they
             traffic in JsonNode, which the public SDK surface keeps out (see
             HookEvent.PreservedFields for the same reasoning). Making them public
             to serve one consumer would be a worse trade than this grant.

             NOTE: this is an assembly attribute, not a reference — AgentForge.Sdk
             still cannot see anything in ClaudeForge.Sdk.Claude, and
             AssemblyLayeringTests still holds. -->
        <InternalsVisibleTo Include="ClaudeForge.Sdk.Claude"/>

        <!-- ClaudeForge (the GUI) is granted internals visibility for the duration
             of the SDK migration. The GUI uses the
             internal `FromExistingWorkspace` constructor to wrap a pre-loaded
             SettingsWorkspace, sharing state with the SDK during the editor-VM
             migration. After 4.3.7 fully removes the legacy workspace fields
             from MainWindowViewModel this grant should be removed and the GUI
             consume only the public SDK surface. -->
        <InternalsVisibleTo Include="ClaudeForge"/>

        <!-- ClaudeForge.Tests covers VMs that take AgentConfigClientCore in
             their ctor (EffectiveSettingsViewModel, EnvironmentEditorViewModel
             post-4.3.7-step-11). Tests construct clients via the internal
             `FromExistingWorkspace` overload so they can wrap an in-memory
             workspace without doing real disk I/O. Same expiration as the
             ClaudeForge grant — remove once 4.3.7 fully retires the wrap path. -->
        <InternalsVisibleTo Include="ClaudeForge.Tests"/>
    </ItemGroup>
</Project>
