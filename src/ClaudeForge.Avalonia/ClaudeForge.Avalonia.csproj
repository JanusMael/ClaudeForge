<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <IsPackable>false</IsPackable>  <!-- product-specific: one product's half, no second consumer -->
        <RootNamespace>Bennewitz.Ninja.ClaudeForge.Avalonia</RootNamespace>
        <AssemblyName>ClaudeForge.Avalonia</AssemblyName>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <Description>
            Reusable Avalonia controls + view-models for editing Claude Code
            permission rules: a guided per-tool rule builder, a dry-run rule
            tester, and an education panel. Depends on AgentForge.Sdk (for the
            rule parser / matchers / resolver) + Avalonia + CommunityToolkit.Mvvm.
            Hosts adapt their own data source via the IPermissionRuleSource /
            IPermissionRuleSink / IPermissionPathPicker abstractions so the
            controls drop into any Claude-adjacent Avalonia tool.
        </Description>
    </PropertyGroup>

    <!-- The solution's friend grants, in one shared file next to the .slnx. LINKED, not
         copied, by a relative path with forward slashes so Linux and macOS resolve it the
         same way Windows does. Read that file before adding a name: it is compiled into
         every assembly, so a grant there applies to all of them. -->
    <ItemGroup>
        <Compile Include="../../AssemblyInfo.InternalsVisibleTo.cs" Link="Properties/AssemblyInfo.InternalsVisibleTo.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <!-- Semi flows transitively so a consuming app picks up matching styling
             if it opts into the Semi theme; omit-able by Fluent consumers. -->
        <PackageReference Include="Semi.Avalonia" Version="12.1.0" PrivateAssets="" />
    </ItemGroup>

    <!-- plans/00005 step 1: the nuget.org packages that replace the LayeredEditors projects.
         Both are referenced for now; the LayeredEditors ProjectReferences below go in
         step 2, together with the namespace changes that make them unnecessary. -->
    <ItemGroup>
        <PackageReference Include="Bennewitz.Ninja.AppServices.Abstractions" Version="$(AppServicesVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AgentForge.Sdk\AgentForge.Sdk.csproj" />
        <ProjectReference Include="..\ClaudeForge.Sdk.Claude\ClaudeForge.Sdk.Claude.csproj" />
        <!-- Neutral host-service interfaces (IPermissionPathPicker lives here: it is a file
             picker, not a permissions type). -->
        <ProjectReference Include="..\LayeredEditors.Avalonia.Services\LayeredEditors.Avalonia.Services.csproj" />
    </ItemGroup>

</Project>
