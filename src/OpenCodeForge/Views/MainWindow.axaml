<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bennewitz.Ninja.OpenCodeForge.ViewModels"
        xmlns:libvm="using:Bennewitz.Ninja.LayeredEditors.Avalonia.ViewModels"
        xmlns:views="using:Bennewitz.Ninja.OpenCodeForge.Views"
        xmlns:search="using:Bennewitz.Ninja.AgentForge.Avalonia.Shell.Search"
        x:Class="Bennewitz.Ninja.OpenCodeForge.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="860">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Search. Results replace the page area while a query is present. -->
        <Grid Grid.Row="0" Margin="8" ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0"
                     Text="{Binding Search.SearchQuery, Mode=TwoWay}"
                     Watermark="Search settings"
                     AutomationProperties.Name="Search settings" />
            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.7"
                       Text="{Binding Search.SearchResults.Count, StringFormat='{}{0} results'}"
                       IsVisible="{Binding Search.SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="280,*">
            <!-- Navigation: one header per hosted product, one child per settings page. -->
            <TreeView Grid.Column="0"
                      ItemsSource="{Binding Navigation}"
                      SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                      AutomationProperties.Name="Settings navigation">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="libvm:NavigationNodeViewModel">
                        <TextBlock Text="{Binding Title}" Margin="2,4" />
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- The selected page's editor. The template lives in its own control so the window
                 markup stays about layout. -->
            <!-- Either the selected page, or the search results. -->
            <Panel Grid.Column="1">
                <!-- The wrapper keeps the view-model as its DataContext so IsVisible can bind
                     to the query; only the inner control switches to the editor. -->
                <ContentControl IsVisible="{Binding !Search.SearchQuery.Length}">
                    <views:SettingsPageHost DataContext="{Binding SelectedNode.Editor}" />
                </ContentControl>

                <ListBox ItemsSource="{Binding Search.SearchResults}"
                         SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                         AutomationProperties.Name="Search results"
                         IsVisible="{Binding Search.SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="search:SearchResultViewModel">
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding PropertyDisplayName}" FontWeight="SemiBold" />
                                <TextBlock Opacity="0.7" FontSize="12"
                                           Text="{Binding GroupTitle}" />
                                <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                                           Text="{Binding Snippet}"
                                           IsVisible="{Binding Snippet, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Panel>
        </Grid>

        <!-- Only visible when something failed to load; an empty status must not reserve space. -->
        <Border Grid.Row="2" Padding="10,6" Background="#FFB71C1C"
                IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Status}" Foreground="White" TextWrapping="Wrap"
                       AutomationProperties.Name="Load status" />
        </Border>
    </Grid>
</Window>
