<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bennewitz.Ninja.OpenCodeForge.ViewModels"
        xmlns:libvm="using:Bennewitz.Ninja.LayeredEditors.Avalonia.ViewModels"
        xmlns:views="using:Bennewitz.Ninja.OpenCodeForge.Views"
        xmlns:search="using:Bennewitz.Ninja.AgentForge.Avalonia.Shell.Search"
        xmlns:services="using:Bennewitz.Ninja.OpenCodeForge.Services"
        xmlns:conv="using:Bennewitz.Ninja.LayeredEditors.Avalonia.Converters"
        x:Class="Bennewitz.Ninja.OpenCodeForge.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="860">

    <Window.Resources>
        <!-- Same converters the settings row's wrapper uses, so a severity reads identically on
             both surfaces. The brush converter resolves the themed AppSeverity*Brush pair, which
             this app declares in App.axaml alongside ClaudeForge’s. -->
        <conv:AppSeverityToBrushConverter x:Key="SeverityToBrush" />
        <conv:AppSeverityToGlyphConverter x:Key="SeverityToGlyph" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Install banner. Informational only: editing a config for a not-yet-installed agent
             is legitimate, so this never blocks. -->
        <Border Grid.Row="0" Padding="12,8" Background="#FF37474F"
                IsVisible="{Binding ShowInstallBanner}">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding InstallBannerText}" Foreground="White" TextWrapping="Wrap"
                           AutomationProperties.Name="Install status" />
                <ItemsControl ItemsSource="{Binding InstallOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:InstallOption">
                            <StackPanel Margin="0,2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Label}" Foreground="#FFB0BEC5"
                                               FontWeight="SemiBold" MinWidth="130" />
                                    <SelectableTextBlock Text="{Binding Command}" Foreground="White"
                                                         FontFamily="Consolas,Menlo,monospace" />
                                </StackPanel>
                                <TextBlock Text="{Binding Note}" Foreground="#FFB0BEC5" FontSize="11"
                                           TextWrapping="Wrap" Margin="138,0,0,0"
                                           IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Search. Results replace the page area while a query is present. -->
        <Grid Grid.Row="1" Margin="8" ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0"
                     Text="{Binding Search.SearchQuery, Mode=TwoWay}"
                     PlaceholderText="Search settings"
                     AutomationProperties.Name="Search settings" />
            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.7"
                       Text="{Binding Search.SearchResults.Count, StringFormat='{}{0} results'}"
                       IsVisible="{Binding Search.SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="280,*">
            <!-- Navigation: one header per hosted product, one child per settings page. -->
            <TreeView Grid.Column="0"
                      ItemsSource="{Binding Navigation}"
                      SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                      AutomationProperties.Name="Settings navigation">
                <TreeView.Styles>
                    <!--
                        ⛔ THIS is what names a nav row for a screen reader. The TextBlock below
                        names only ITSELF.

                        A TreeViewItem generated from ItemsSource takes no automation name from its
                        ItemTemplate, and unlike a TabItem it does not fall back to the item's
                        ToString() either — it falls back to nothing. Measured through UIA on the
                        running app: all three rows of this tree announced an EMPTY name, even
                        though the template is a single bound TextBlock.

                        ⚠ A lone TextBlock root does NOT supply the container's name. That belief
                        cost real time here: an older harness recipe looked the pages up by finding
                        the Text LEAF and walking UP to its TreeItem ancestor, which made this tree
                        look correctly labelled when only the TextBlock was.

                        x:DataType keeps the binding compiled; a reflection binding here is an
                        IL2026 trim error in this repo. See docs/AVALONIA-GOTCHAS.md.
                    -->
                    <Style Selector="TreeViewItem" x:DataType="libvm:NavigationNodeViewModel">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />

                        <!-- The schema-provenance detail rides HelpText on the CONTAINER, for two
                             reasons. UIA announces name then help text, so focusing a section row
                             reads "OpenCode" and then which copy of the schema built it. And the
                             badge TextBlock in the template cannot carry it: AutomationProperties.Name
                             is IGNORED on a TextBlock — its Text always wins — so a Name there
                             would be dead markup, which this repo already has fifteen instances of.
                             Empty on rows with no badge, which UIA treats as absent. -->
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding BadgeTooltip}" />
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="libvm:NavigationNodeViewModel">
                        <!-- Title + optional schema-provenance badge. Layout follows ClaudeForge’s
                             nav template: a horizontal StackPanel with Spacing, and the tooltip
                             repeated on the element the pointer actually lands on, because Avalonia
                             tooltips do not propagate from child to parent. -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Title}" Margin="2,4" VerticalAlignment="Center" />

                            <!-- Secondary text is Opacity, not a colour token — the convention in
                                 this library, and it keeps the badge legible in both theme variants
                                 without declaring a brush per variant. -->
                            <TextBlock Text="{Binding Badge}"
                                       IsVisible="{Binding Badge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="10"
                                       Opacity="0.65"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding BadgeTooltip}" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- The selected page's editor. The template lives in its own control so the window
                 markup stays about layout. -->
            <!-- Either the selected page, or the search results. -->
            <Panel Grid.Column="1">
                <!-- The wrapper keeps the view-model as its DataContext so IsVisible can bind
                     to the query; only the inner control switches to the editor. -->
                <!--
                    ⚠ Content, not a hardcoded SettingsPageHost. NavigationNodeViewModel.Editor is
                    typed `object?` and always was, so the navigation tree never cared what kind of
                    page a node owned — but naming one host here meant every page had to BE a
                    schema settings group. The artifacts page is not one, so App.axaml now picks the
                    view by view-model type, exactly as it already does for the specialised editors.
                    A missing DataTemplate renders the type name and logs nothing, which is what
                    OpenCodePageTemplateTests exists to catch.
                -->
                <ContentControl IsVisible="{Binding !Search.SearchQuery.Length}"
                                Content="{Binding SelectedNode.Editor}" />

                <ListBox ItemsSource="{Binding Search.SearchResults}"
                         SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                         AutomationProperties.Name="Search results"
                         IsVisible="{Binding Search.SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="search:SearchResultViewModel">
                            <StackPanel Margin="4">
                                <!--
                                    Severity dot, so a search lands on a knob already labelled
                                    rather than one the user has to open to judge. Same glyphs,
                                    same tokens and the same bound member names as the settings
                                    row's PropertyEditorWrapper - the assessment is literally that
                                    row's own, fetched through IDangerAnnotatedEditor, so the two
                                    surfaces cannot disagree.

                                    ⛔ HelpText, never Name: a TextBlock's Text always wins and an
                                    explicit Name is ignored (see AVALONIA-GOTCHAS). Wrapping the
                                    glyph to work around that is worse - a Border and a
                                    ContentControl both get no automation peer at all.
                                -->
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock IsVisible="{Binding HasDangerSeverity}"
                                               Text="{Binding Danger.Severity, Converter={StaticResource SeverityToGlyph}}"
                                               Foreground="{Binding Danger.Severity, Converter={StaticResource SeverityToBrush}}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               AutomationProperties.HelpText="{Binding DangerAccessibleText}"
                                               ToolTip.Tip="{Binding DangerAccessibleText}" />
                                    <TextBlock Text="{Binding PropertyDisplayName}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Opacity="0.7" FontSize="12"
                                           Text="{Binding GroupTitle}" />
                                <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                                           Text="{Binding Snippet}"
                                           IsVisible="{Binding Snippet, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Panel>
        </Grid>

        <!-- Only visible when something failed to load; an empty status must not reserve space. -->
        <Border Grid.Row="3" Padding="10,6" Background="#FFB71C1C"
                IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Status}" Foreground="White" TextWrapping="Wrap"
                       AutomationProperties.Name="Load status" />
        </Border>
    </Grid>
</Window>
