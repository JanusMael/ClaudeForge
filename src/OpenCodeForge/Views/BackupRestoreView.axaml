<!--
    OpenCodeForge's Backup / Restore page.

    The view-model is the SHARED one — AgentForge.Avalonia.Shell.Backup.BackupRestoreViewModel —
    so this file is markup only; everything product-shaped that is not markup lives in
    ViewModels/OpenCodeBackupPage.cs. It is a sibling of ClaudeForge's BackupRestoreView.axaml
    rather than a copy of it, and the four places they deliberately differ are marked below.

    Same rules as every other view in this app:
      * x:DataType everywhere, so bindings are COMPILED and a renamed member is a build error.
      * No ancestor bindings — they resolve by reflection and trip IL2026.
      * Theme tokens and Opacity, never literal colours. ClaudeForge's copy of this page carries
        six light-mode hex literals for its advisory banners; they are not carried over, because
        an #FFF3CD panel with #664D03 text is unreadable in Semi Dark.
      * All text from Strings.resx, including every AutomationProperties.Name.

    ⛔ NO MSIX TAB. ClaudeForge's third tab fixes an MSIX-virtualised *Claude Desktop* install, and
    MsixPathProbe scans %LOCALAPPDATA%\Packages for a Claude_* package. ShowMsixTab would therefore
    go true on any machine that also has Claude Desktop installed — offering, from inside
    OpenCodeForge, to repair another vendor's app. Binding nothing to it is what keeps that off the
    page.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bennewitz.Ninja.AgentForge.Avalonia.Shell.Backup"
             xmlns:ctrl="using:Bennewitz.Ninja.LayeredEditors.Avalonia.Controls"
             xmlns:behaviors="using:Bennewitz.Ninja.LayeredEditors.Avalonia.Behaviors"
             xmlns:loc="clr-namespace:Bennewitz.Ninja.OpenCodeForge.Localization"
             x:Class="Bennewitz.Ninja.OpenCodeForge.Views.BackupRestoreView"
             x:DataType="vm:BackupRestoreViewModel">

    <DockPanel>

        <!-- Header. ClaudeForge uses an accent-pill Border here; NavSelectedAccentBrush is
             declared in that app's MainWindow.axaml and does not exist in this one. The plain
             heading + Opacity subtitle is this app's own page-header idiom — see
             OpenCodeArtifactsPageView and OpenCodeEssentialsView. -->
        <Border DockPanel.Dock="Top" Padding="16,12"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static loc:Strings.HeadingBackupRestore}"
                           FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:Strings.TextBackupRestoreSubtitle}"
                           TextWrapping="Wrap" MaxWidth="700" Opacity="0.8" />
            </StackPanel>
        </Border>

        <!--
            What-backups-include explainer, in plain language, at the moment of action. The three
            bullets describe OpenCode's layout specifically: the config root is archived whole and
            its own .gitignore does the excluding, so there is no skip list here to fall out of date.
        -->
        <Border DockPanel.Dock="Top" Margin="16,8,16,0"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1" CornerRadius="4" Padding="14,10">
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.HeadingBackupContents}"
                           FontSize="13" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="•" Opacity="0.7" />
                    <TextBlock Text="{x:Static loc:Strings.TextBackupContentsLine1}"
                               FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="•" Opacity="0.7" />
                    <TextBlock Text="{x:Static loc:Strings.TextBackupContentsLine2}"
                               FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="•" Opacity="0.7" />
                    <TextBlock Text="{x:Static loc:Strings.TextBackupContentsLine3}"
                               FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="{x:Static loc:Strings.TextBackupContentsExcluded}"
                           FontSize="11" FontStyle="Italic" Opacity="0.8"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{x:Static loc:Strings.TextBackupContentsProjectNote}"
                           FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Status + progress footer (shared across tabs) -->
        <Border DockPanel.Dock="Bottom" Padding="16,6"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding IsBusy}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="{x:Static loc:Strings.ButtonCancel}"
                        AutomationProperties.Name="{x:Static loc:Strings.ButtonCancel}"
                        Command="{Binding CancelOperationCommand}"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        ToolTip.Tip="{x:Static loc:Strings.TipButtonCancel}" />
                <StackPanel Orientation="Vertical" Spacing="4">
                    <TextBlock Text="{Binding ProgressMessage}" />
                    <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    AutomationProperties.Name="{x:Static loc:Strings.AutoNameBackupRestoreTabs}">

            <!-- =========================== BACKUP TAB =========================== -->
            <TabItem Header="{x:Static loc:Strings.TabBackup}"
                     AutomationProperties.Name="{x:Static loc:Strings.TabBackup}">
                <ScrollViewer>
                    <StackPanel Margin="16" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding LastBackupLabel}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static loc:Strings.TextNoBackupYetDescription}"
                                       FontSize="11" Opacity="0.8"
                                       IsVisible="{Binding HasNeverBackedUp}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Primary action first, as on the sibling app's tab. Stays disabled via
                             CanCreateBackup until an output folder is chosen below. -->
                        <Button Content="{x:Static loc:Strings.ButtonCreateBackup}"
                                AutomationProperties.Name="{x:Static loc:Strings.ButtonCreateBackup}"
                                Command="{Binding BackupCommand}"
                                IsEnabled="{Binding CanCreateBackup}"
                                HorizontalAlignment="Left"
                                Padding="20,10"
                                FontWeight="SemiBold" />

                        <TextBlock Text="{x:Static loc:Strings.LabelOutputFolder}" FontWeight="SemiBold"
                                   Margin="0,8,0,0" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="{x:Static loc:Strings.ButtonBrowse}"
                                    AutomationProperties.Name="{x:Static loc:Strings.AutoNameBrowseBackupFolder}"
                                    Command="{Binding BrowseBackupDirectoryCommand}"
                                    Margin="8,0,0,0" />
                            <TextBox Text="{Binding BackupDirectory}"
                                     AutomationProperties.Name="{x:Static loc:Strings.LabelOutputFolder}"
                                     PlaceholderText="{x:Static loc:Strings.WatermarkBackupDir}"
                                     IsReadOnly="True" />
                        </DockPanel>
                        <TextBlock Text="{x:Static loc:Strings.TextBackupDirHint}"
                                   FontSize="11" Opacity="0.8" TextWrapping="Wrap"
                                   IsVisible="{Binding BackupDirectory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{x:Static loc:Strings.TextNoBackupDirWarning}"
                                   FontSize="11"
                                   Foreground="{DynamicResource LE.DangerText}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding BackupDirectory, Converter={x:Static StringConverters.IsNullOrEmpty}}" />

                        <!-- ⓘ No project-inclusion advisory here, unlike ClaudeForge's tab. That
                             line reports whether the open project's .claude directory travels in
                             the archive; OpenCodeForge opens its clients with projectRoot: null and
                             the engine's per-project block is gated on the Claude Code product, so
                             the label could only ever have read "no project open". -->

                        <TextBlock Text="{x:Static loc:Strings.LabelScope}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <!-- ⛔ TWO radios, not ClaudeForge's three. BackupMode.Full differs from
                             SettingsOnly only by which of a product's SkippedSubdirs it lets
                             through, and OpenCodeProducts.Config declares none — the config root's
                             own .gitignore does that work. The two modes would therefore produce
                             byte-identical archives distinguishable only by the label the manifest
                             records, which the Restore tab's Mode column then shows as if it meant
                             something. -->
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <RadioButton GroupName="BackupMode"
                                         Content="{x:Static loc:Strings.RadioSettingsOnly}"
                                         AutomationProperties.Name="{x:Static loc:Strings.RadioSettingsOnly}"
                                         IsChecked="{Binding Mode, Converter={x:Static vm:BackupModeConverter.IsSettingsOnly}}" />
                            <RadioButton GroupName="BackupMode"
                                         Content="{x:Static loc:Strings.RadioSanitizedBackup}"
                                         AutomationProperties.Name="{x:Static loc:Strings.RadioSanitizedBackup}"
                                         ToolTip.Tip="{x:Static loc:Strings.TipRadioSanitizedBackup}"
                                         IsChecked="{Binding Mode, Converter={x:Static vm:BackupModeConverter.IsSanitized}}" />
                        </StackPanel>

                        <!-- Secrets-leak advisory, shown for every non-Sanitized mode: API keys,
                             OAuth tokens and MCP auth headers DO travel verbatim inside the
                             archive. Suppressed for Sanitized, where the redactor scrubs them. -->
                        <Border BorderBrush="{DynamicResource LE.DangerBorder}" BorderThickness="1"
                                CornerRadius="3" Padding="8,6"
                                IsVisible="{Binding ShowSecretsWarning}">
                            <TextBlock Text="{x:Static loc:Strings.TextBackupSecretsWarning}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource LE.DangerText}" />
                        </Border>
                        <!-- Mode-specific explainer for Sanitized — visible only when Sanitized is
                             selected, so the trade-off (not restorable) lands before the click. -->
                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="8,6"
                                IsVisible="{Binding Mode, Converter={x:Static vm:BackupModeConverter.IsSanitized}}">
                            <TextBlock Text="{x:Static loc:Strings.TextSanitizedModeExplainer}"
                                       FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="{x:Static loc:Strings.LabelClients}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <!-- One checkbox per hosted product, from SelectableProducts — the window
                             supplies the set, so markup never enumerates products. -->
                        <ItemsControl ItemsSource="{Binding SelectableProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BackupProductViewModel">
                                    <CheckBox Content="{Binding DisplayName}"
                                              AutomationProperties.Name="{Binding DisplayName}"
                                              IsChecked="{Binding IsSelected}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Static loc:Strings.LabelRetention}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Static loc:Strings.LabelKeepLast}" VerticalAlignment="Center" />
                            <NumericUpDown Value="{Binding KeepLast}" Minimum="0" Maximum="100"
                                           AutomationProperties.Name="{x:Static loc:Strings.LabelKeepLast}"
                                           FormatString="0" Width="100" />
                            <TextBlock Text="{x:Static loc:Strings.LabelKeepAll}" VerticalAlignment="Center"
                                       Opacity="0.8" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   FontStyle="Italic" Opacity="0.8" TextWrapping="Wrap"
                                   IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =========================== RESTORE TAB =========================== -->
            <TabItem Header="{x:Static loc:Strings.TabRestore}"
                     AutomationProperties.Name="{x:Static loc:Strings.TabRestore}">
                <!-- Drag a backup-*.zip from the file manager onto this tab. FileDrop is a reusable
                     attached behaviour in LayeredEditors.Avalonia.Behaviors; it filters payloads by
                     extension during DragOver and invokes the command with the local path. Set on
                     the DockPanel so the whole tab body accepts a drop, empty state included. -->
                <DockPanel behaviors:FileDrop.AllowedExtensions="zip"
                           behaviors:FileDrop.DropCommand="{Binding RestoreFromDroppedArchiveCommand}">

                    <Border DockPanel.Dock="Top" Padding="12,8"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Static loc:Strings.TextRestoreDescription}"
                                       FontSize="11" TextWrapping="Wrap" Opacity="0.8" />
                            <TextBlock Text="{x:Static loc:Strings.LabelRestoreFolder}" FontWeight="SemiBold" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="{x:Static loc:Strings.ButtonBrowse}"
                                        AutomationProperties.Name="{x:Static loc:Strings.AutoNameBrowseRestoreFolder}"
                                        Command="{Binding BrowseRestoreDirectoryCommand}"
                                        Margin="8,0,0,0" />
                                <TextBox Text="{Binding RestoreDirectory}"
                                         AutomationProperties.Name="{x:Static loc:Strings.LabelRestoreFolder}"
                                         PlaceholderText="{x:Static loc:Strings.WatermarkRestoreDir}"
                                         IsReadOnly="True" />
                            </DockPanel>
                            <TextBlock Text="{x:Static loc:Strings.TextNoRestoreDirWarning}"
                                       FontSize="11"
                                       Foreground="{DynamicResource LE.DangerText}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding !HasRestoreDirectory}" />
                        </StackPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Margin="16,32"
                               Text="{x:Static loc:Strings.TextChooseRestoreFolder}"
                               HorizontalAlignment="Center" FontSize="14" Opacity="0.8"
                               IsVisible="{Binding !HasRestoreDirectory}" />

                    <TextBlock DockPanel.Dock="Top" Margin="16,12,16,6"
                               Text="{x:Static loc:Strings.TextRestoreInstructions}"
                               Opacity="0.8" TextWrapping="Wrap"
                               IsVisible="{Binding HasRestoreDirectory}" />

                    <DataGrid x:Name="BackupDataGrid"
                              AutomationProperties.Name="{x:Static loc:Strings.AutoNameBackupsGrid}"
                              ItemsSource="{Binding Backups}"
                              SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                              IsVisible="{Binding HasRestoreDirectory}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              PointerPressed="OnBackupDataGridPointerPressed"
                              behaviors:CopyValue.IsEnabled="True"
                              Margin="12">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static loc:Strings.MenuOpenFileLocation}"
                                          Command="{Binding OpenFileLocationCommand}"
                                          CommandParameter="{Binding SelectedBackup}"
                                          AutomationProperties.Name="{x:Static loc:Strings.MenuOpenFileLocation}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <!-- Column widths are first-paint defaults for a ~950 px window, not
                             ceilings — every column stays user-resizable via the grippers. File is
                             the * flex column with MinWidth=180 so it never squeezes to nothing
                             when the fixed columns sum past the available width. -->
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="150" MinWidth="100" SortMemberPath="DisplayDate">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{x:Static loc:Strings.HeaderBackupDate}"
                                               ToolTip.Tip="{x:Static loc:Strings.TipHeaderBackupDate}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:BackupRowViewModel">
                                        <ctrl:TipCell Tip="{Binding DisplayDate}">
                                            <TextBlock Text="{Binding DisplayDate}"
                                                       VerticalAlignment="Center" Margin="4,0" />
                                        </ctrl:TipCell>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*" MinWidth="180" SortMemberPath="DisplayName">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{x:Static loc:Strings.HeaderBackupFile}"
                                               ToolTip.Tip="{x:Static loc:Strings.TipHeaderBackupFile}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:BackupRowViewModel">
                                        <ctrl:TipCell Tip="{Binding DisplayName}">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       VerticalAlignment="Center" Margin="4,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </ctrl:TipCell>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="100" MinWidth="90" SortMemberPath="DisplayPlatform">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{x:Static loc:Strings.HeaderBackupPlatform}"
                                               ToolTip.Tip="{x:Static loc:Strings.TipHeaderBackupPlatform}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:BackupRowViewModel">
                                        <ctrl:TipCell Tip="{Binding DisplayPlatform}">
                                            <TextBlock Text="{Binding DisplayPlatform}"
                                                       VerticalAlignment="Center" Margin="4,0" />
                                        </ctrl:TipCell>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="110" MinWidth="85" SortMemberPath="DisplayMode">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{x:Static loc:Strings.HeaderBackupMode}"
                                               ToolTip.Tip="{x:Static loc:Strings.TipHeaderBackupMode}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:BackupRowViewModel">
                                        <!-- DisplayModeTooltip carries the long-form
                                             "(for sharing — not restorable)" that the compact chip
                                             label omits. -->
                                        <ctrl:TipCell Tip="{Binding DisplayModeTooltip}">
                                            <Grid>
                                                <TextBlock Text="{Binding DisplayMode}"
                                                           VerticalAlignment="Center" Margin="4,0"
                                                           IsVisible="{Binding !IsSanitized}" />
                                                <!-- Outlined chip for Sanitized rows, so a
                                                     sharing-only archive is recognisable at a
                                                     glance and correlates with the disabled Restore
                                                     button on the same row. -->
                                                <Border CornerRadius="3" Padding="6,2"
                                                        BorderBrush="{DynamicResource LE.DangerBorder}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center" Margin="4,0"
                                                        IsVisible="{Binding IsSanitized}">
                                                    <TextBlock Text="{Binding DisplayMode}"
                                                               Foreground="{DynamicResource LE.DangerText}"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </ctrl:TipCell>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="110" MinWidth="80" SortMemberPath="DisplayClients">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{x:Static loc:Strings.HeaderBackupClients}"
                                               ToolTip.Tip="{x:Static loc:Strings.TipHeaderBackupClients}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:BackupRowViewModel">
                                        <ctrl:TipCell Tip="{Binding DisplayClientsTooltip}">
                                            <TextBlock Text="{Binding DisplayClients}"
                                                       VerticalAlignment="Center" Margin="4,0" />
                                        </ctrl:TipCell>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="75" MinWidth="55" SortMemberPath="DisplaySize">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{x:Static loc:Strings.HeaderBackupSize}"
                                               ToolTip.Tip="{x:Static loc:Strings.TipHeaderBackupSize}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:BackupRowViewModel">
                                        <ctrl:TipCell Tip="{Binding DisplaySize}">
                                            <TextBlock Text="{Binding DisplaySize}"
                                                       VerticalAlignment="Center" Margin="4,0" />
                                        </ctrl:TipCell>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="220" MinWidth="180">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{x:Static loc:Strings.HeaderBackupActions}"
                                               ToolTip.Tip="{x:Static loc:Strings.TipHeaderBackupActions}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:BackupRowViewModel">
                                        <!-- Explicit Padding trims the Semi.Avalonia default so all
                                             three buttons fit a 220 px column.

                                             ⚠ The three accessible names are the row's file name
                                             plus an English verb, formatted in markup — the one
                                             place on this page where user-visible text is not
                                             resx-sourced. Carried over from the sibling app
                                             deliberately: the alternative is three more required
                                             BackupPageText members, and the wording has to stay
                                             identical between the two apps regardless. -->
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center">
                                            <Button Content="{x:Static loc:Strings.ButtonRestore}"
                                                    Padding="10,4"
                                                    AutomationProperties.Name="{Binding DisplayName, StringFormat='{}{0} — Restore'}"
                                                    IsEnabled="{Binding IsRestorable}"
                                                    Click="OnRestoreBackup" />
                                            <Button Content="{x:Static loc:Strings.ButtonDeleteBackup}"
                                                    Padding="10,4"
                                                    AutomationProperties.Name="{Binding DisplayName, StringFormat='{}{0} — Delete'}"
                                                    Click="OnDeleteBackup" />
                                            <Button Content="{x:Static loc:Strings.ButtonShareBackup}"
                                                    Padding="10,4"
                                                    AutomationProperties.Name="{Binding DisplayName, StringFormat='{}{0} — Share'}"
                                                    ToolTip.Tip="{x:Static loc:Strings.TipButtonShareBackup}"
                                                    Click="OnShareBackup" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</UserControl>
