<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Bennewitz.Ninja.AgentForge.Avalonia.Shell.Settings"
             xmlns:libvm="using:Bennewitz.Ninja.LayeredEditors.Avalonia.ViewModels"
             xmlns:lecontrols="using:Bennewitz.Ninja.LayeredEditors.Avalonia.Controls"
             x:Class="Bennewitz.Ninja.OpenCodeForge.Views.SettingsPageHost"
             x:DataType="shell:SettingsGroupEditorViewModel">

    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12">
            <TextBlock Text="{Binding GroupName}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding GroupDescription}" Opacity="0.75" TextWrapping="Wrap"
                       IsVisible="{Binding GroupDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Scope selector: which layer of the config is being edited. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Scope" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding AvailableScopes}"
                          SelectedItem="{Binding EditingScope, Mode=TwoWay}"
                          MinWidth="160"
                          AutomationProperties.Name="Editing scope" />
            </StackPanel>

            <!-- The editors themselves, rendered by the shared library's wrapper so both apps
                 present identical editor chrome. -->
            <ItemsControl ItemsSource="{Binding FilteredEditors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="libvm:PropertyEditorViewModel">
                        <lecontrols:PropertyEditorWrapper Margin="0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
