<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:perm="using:Bennewitz.Ninja.OpenCode.Avalonia.Permissions"
             xmlns:mcp="using:Bennewitz.Ninja.OpenCode.Avalonia.Mcp"
             xmlns:agents="using:Bennewitz.Ninja.OpenCode.Avalonia.Agents"
             xmlns:cmd="using:Bennewitz.Ninja.OpenCode.Avalonia.Commands"
             xmlns:plug="using:Bennewitz.Ninja.OpenCode.Avalonia.Plugins"
             xmlns:tool="using:Bennewitz.Ninja.OpenCode.Avalonia.Tooling"
             xmlns:upd="using:Bennewitz.Ninja.OpenCode.Avalonia.Updates"
             xmlns:kb="using:Bennewitz.Ninja.OpenCode.Avalonia.Keybinds"
             xmlns:art="using:Bennewitz.Ninja.OpenCode.Avalonia.Artifacts"
             xmlns:shell="using:Bennewitz.Ninja.AgentForge.Avalonia.Shell.Settings"
             xmlns:views="using:Bennewitz.Ninja.OpenCodeForge.Views"
             x:Class="Bennewitz.Ninja.OpenCodeForge.App"
             RequestedThemeVariant="Default">

    <!-- Same opt-in Semi theme the sibling app uses, from the shared editor library, so both
         apps present identical editor chrome. -->
    <Application.Styles>
        <StyleInclude Source="avares://LayeredEditors.Avalonia/Themes/SemiBundle.axaml" />
        <Style Selector="ToolTip">
            <Setter Property="MaxWidth" Value="900" />
        </Style>
    </Application.Styles>

    <!--
        ⛔⛔ THE TWO BRUSHES BELOW ARE NOT DECORATION — WITHOUT THEM EVERY PROPERTY HEADING ON EVERY
        SETTINGS PAGE IN THIS APP RENDERED UNSTYLED, AND NOTHING REPORTED IT.

        `PropertyEditorWrapper` lives in the shared editor library and wraps every property editor
        this app shows (Views/SettingsPageHost.axaml). Its heading chip asks for
        AppPropertyHeadingBackgroundBrush and AppPropertyHeadingBrush — host-supplied tokens, by the
        `App*` naming convention — and this file had no Application.Resources block at all, so
        neither resolved. An unresolvable DynamicResource is not a build error, not a runtime error,
        and logs nothing: the Border simply kept a null Background. Measured on screen before the
        fix, the property names rendered as plain bold text, still carrying the chip's 8px padding
        while the chip itself was invisible — which is why every label sat indented from its own
        description.

        Same defect family as the LE.DangerText / LE.DangerBorder keys that were referenced nine
        times and declared nowhere (`c7ea6fe`), and it is now caught mechanically by
        ThemeResourceIntegrityTests: a token a SHARED library references must be defined by EVERY
        app that consumes that library.

        The values are deliberately the sibling app's, not new ones. The Application.Styles comment
        above states the intent ("so both apps present identical editor chrome") and these two
        tokens are exactly the chrome it was talking about. Their contrast is already measured and
        documented in ClaudeForge/App.axaml: heading foreground #1E5573 is ~5.7:1 on white (WCAG AA
        Normal) and #74C2DE is ~8.3:1 on #1A1A1A (WCAG AAA). Inventing a second palette here would
        mean shipping unverified contrast to make two sibling apps look gratuitously different.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <!--
                ThemeDictionaries, not flat entries: a heading BACKGROUND cannot be theme-neutral
                the way a foreground accent can. One value that reads on Semi Light is either
                invisible or glaring on Semi Dark.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppPropertyHeadingBackgroundBrush" Color="#B8DCE2" />
                    <SolidColorBrush x:Key="AppPropertyHeadingBrush" Color="#1E5573" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppPropertyHeadingBackgroundBrush" Color="#1B3A45" />
                    <SolidColorBrush x:Key="AppPropertyHeadingBrush" Color="#74C2DE" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!--
        Application-level DataTemplates for this product's specialised editors. The editor library
        does not know these view-model types, so its PropertyEditorWrapper renders them through a
        ContentControl that falls through to here. This is the ONLY thing that connects a
        specialised editor's view-model to its view — an editor registered in OpenCodeEditorFactory
        with no entry here renders as the view-model's type name, which reads as a broken page
        rather than as a missing template.
    -->
    <Application.DataTemplates>

        <!--
            PAGE templates, not editor templates. MainWindow binds the selected navigation node's
            Editor straight into a ContentControl, so these decide which whole page appears.
            NavigationNodeViewModel.Editor is `object?`, which is what makes a non-schema page
            possible at all — before this the window named SettingsPageHost directly, so every page
            had to be a schema settings group.
        -->
        <DataTemplate DataType="shell:SettingsGroupEditorViewModel">
            <views:SettingsPageHost />
        </DataTemplate>

        <DataTemplate DataType="art:OpenCodeArtifactsPageViewModel">
            <art:OpenCodeArtifactsPageView />
        </DataTemplate>

        <!-- MaxHeight rather than Height so a config with two rules does not leave a tall empty
             panel below them; the view's own ScrollViewer handles a long grid.

             ⚠⚠ That second clause was FALSE until 9a-8: not one view in OpenCode.Avalonia had a
             ScrollViewer, so every MaxHeight here CLIPPED instead of scrolling. Measured by
             screenshot and by the UIA tree — a four-server `lsp` config laid its last two entries
             out at y=1262 and y=1565 against a window bottom edge of y=1100, with the page's only
             scroller already at 100%, and those two were exactly the entries the editor's own red
             banner was pointing at. Every view now carries a ScrollViewer; a MaxHeight added here
             for a view without one is a clip, not a cap. -->
        <DataTemplate DataType="perm:OpenCodePermissionEditorViewModel">
            <perm:OpenCodePermissionEditorView MaxHeight="600" />
        </DataTemplate>

        <DataTemplate DataType="mcp:OpenCodeMcpEditorViewModel">
            <mcp:OpenCodeMcpEditorView MaxHeight="700" />
        </DataTemplate>

        <DataTemplate DataType="agents:OpenCodeAgentEditorViewModel">
            <agents:OpenCodeAgentEditorView MaxHeight="800" />
        </DataTemplate>

        <DataTemplate DataType="cmd:OpenCodeCommandEditorViewModel">
            <cmd:OpenCodeCommandEditorView MaxHeight="700" />
        </DataTemplate>

        <DataTemplate DataType="plug:OpenCodePluginEditorViewModel">
            <plug:OpenCodePluginEditorView MaxHeight="600" />
        </DataTemplate>

        <DataTemplate DataType="plug:OpenCodePluginEnabledEditorViewModel">
            <plug:OpenCodePluginEnabledEditorView MaxHeight="400" />
        </DataTemplate>

        <DataTemplate DataType="tool:OpenCodeFormatterEditorViewModel">
            <tool:OpenCodeFormatterEditorView MaxHeight="700" />
        </DataTemplate>

        <DataTemplate DataType="tool:OpenCodeLspEditorViewModel">
            <tool:OpenCodeLspEditorView MaxHeight="800" />
        </DataTemplate>

        <!-- No MaxHeight: a picker plus one line of help has nothing to cap, and the number here
             would be a guess that later reads as deliberate. -->
        <DataTemplate DataType="upd:OpenCodeAutoupdateEditorViewModel">
            <upd:OpenCodeAutoupdateEditorView />
        </DataTemplate>

        <!-- ⚠ No MaxHeight here either, and for the opposite reason to autoupdate's: this view is
             the one that must NOT be height-capped from outside. Its own ListBox owns a bounded,
             virtualizing scroll region, and a cap out here would put a second scroller around it —
             giving the inner panel an unbounded viewport, realizing all 184 rows, and undoing the
             one thing this editor exists to do. The view's header measures Auto and the list takes
             the rest, so it sizes itself. -->
        <DataTemplate DataType="kb:OpenCodeKeybindEditorViewModel">
            <kb:OpenCodeKeybindEditorView />
        </DataTemplate>

    </Application.DataTemplates>
</Application>
