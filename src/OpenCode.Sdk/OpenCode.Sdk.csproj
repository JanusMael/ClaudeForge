<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <IsPackable>false</IsPackable>  <!-- product-specific: one product's half, no second consumer -->
        <RootNamespace>Bennewitz.Ninja.OpenCode.Sdk</RootNamespace>
        <AssemblyName>OpenCode.Sdk</AssemblyName>
        <Description>
            OpenCode-domain half of the SDK: the config surfaces that exist only because
            OpenCode defines them — its five-rung scope ladder, its per-key merge rules, its
            nested tool-to-glob permission map — plus the concrete clients (OpenCodeClient,
            OpenCodeTuiClient).

            The sibling of ClaudeForge.Sdk.Claude, and deliberately shaped the same way: it
            references AgentForge.Sdk and never the reverse. AssemblyLayeringTests enforces
            that from the assembly-name prefix alone, so this project needed no registration
            there — "OpenCode" was already one of the product prefixes shared code may not
            reference.

            Nothing Claude-specific may appear here and nothing here may appear in
            AgentForge.*. Where the two products genuinely agree, the vocabulary lives in
            AgentForge.Abstractions instead (see PermissionOutcome).
        </Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <!-- The solution's friend grants, in one shared file next to the .slnx. LINKED, not
         copied, by a relative path with forward slashes so Linux and macOS resolve it the
         same way Windows does. Read that file before adding a name: it is compiled into
         every assembly, so a grant there applies to all of them. -->
    <ItemGroup>
        <Compile Include="../../AssemblyInfo.InternalsVisibleTo.cs" Link="Properties/AssemblyInfo.InternalsVisibleTo.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AgentForge.Sdk\AgentForge.Sdk.csproj"/>

        <!--
            Declared even though AgentForge.Sdk already brings it in transitively: the artifact
            types are used directly here, and a reference that arrives only as a side effect of
            another project's dependencies disappears the moment that project stops needing it.
        -->
        <ProjectReference Include="..\AgentForge.Artifacts\AgentForge.Artifacts.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!--
            The captured shape of OpenCode's opencode.db, produced by
            scripts/refresh-opencode-db-schema.ps1. Embedded rather than left as a test fixture
            so the running app can compare a LIVE database against it — the backup's "this
            archive contains credentials" advisory is a claim about that file, and a claim worth
            making is worth being able to check where it is made. A guard that only runs in CI
            protects the project; one that ships protects the user.
        -->
        <EmbeddedResource Include="Assets\**\*.json"/>
    </ItemGroup>

</Project>
