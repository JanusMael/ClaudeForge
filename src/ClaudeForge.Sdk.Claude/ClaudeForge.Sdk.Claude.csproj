<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <IsPackable>false</IsPackable>  <!-- product-specific: one product's half, no second consumer -->
        <RootNamespace>Bennewitz.Ninja.ClaudeForge.Sdk.Claude</RootNamespace>
        <AssemblyName>ClaudeForge.Sdk.Claude</AssemblyName>
        <Description>
            Claude-domain half of the SDK: the config surfaces that exist only because Claude
            Code / Claude Desktop define them — hooks, plugin marketplaces, enabled plugins,
            the model catalog's effort/auto-mode rules, and Claude's permission rule syntax —
            plus the two concrete clients (ClaudeCodeClient, ClaudeDesktopClient).

            Split out of AgentForge.Sdk so the shared SDK holds only what a second agent
            product can reuse. The dependency runs one way: this project references
            AgentForge.Sdk, never the reverse. AssemblyLayeringTests enforces that.
        </Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <!-- The solution's friend grants, in one shared file next to the .slnx. LINKED, not
         copied, by a relative path with forward slashes so Linux and macOS resolve it the
         same way Windows does. Read that file before adding a name: it is compiled into
         every assembly, so a grant there applies to all of them. -->
    <ItemGroup>
        <Compile Include="../../AssemblyInfo.InternalsVisibleTo.cs" Link="Properties/AssemblyInfo.InternalsVisibleTo.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AgentForge.Sdk\AgentForge.Sdk.csproj"/>
    </ItemGroup>

</Project>
