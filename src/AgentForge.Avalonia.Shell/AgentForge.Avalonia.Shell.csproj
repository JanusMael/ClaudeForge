<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <IsPackable>true</IsPackable>
        <RootNamespace>Bennewitz.Ninja.AgentForge.Avalonia.Shell</RootNamespace>
        <AssemblyName>AgentForge.Avalonia.Shell</AssemblyName>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <Description>
            The product-neutral half of the desktop shell: chrome and services a
            configuration editor needs regardless of which agent product it edits.
            Phase 5 of the OpenCodeForge plan moves pieces here in slices, each
            parameterised on the way through rather than merely relocated.

            Nothing here may name a product. The rule is enforced, not merely
            documented: AssemblyLayeringTests fails the build if any AgentForge.*
            project gains a reference to ClaudeForge.* or OpenCode.*, checking both
            the ProjectReference graph and the compiled assembly references.
        </Description>
    </PropertyGroup>

    <!-- The solution's friend grants, in one shared file next to the .slnx. LINKED, not
         copied, by a relative path with forward slashes so Linux and macOS resolve it the
         same way Windows does. Read that file before adding a name: it is compiled into
         every assembly, so a grant there applies to all of them. -->
    <ItemGroup>
        <Compile Include="../../AssemblyInfo.InternalsVisibleTo.cs" Link="Properties/AssemblyInfo.InternalsVisibleTo.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>

    <!-- plans/00005: the editor and service libraries are external nuget.org packages, split out of
         this repository. ⚠ This project is PACKABLE: every reference here becomes a dependency of
         its published package, so it lists only what its source actually uses. All are neutral
         libraries with no product knowledge, so the layering rule is unaffected. -->
    <ItemGroup>
        <!-- NavigationNodeViewModel, used by deep-path resolution. -->
        <PackageReference Include="Bennewitz.Ninja.ScopedEditors.ViewModels" Version="$(ScopedEditorsVersion)" />
        <!-- The editor abstractions the adapters implement: IEditorWorkspace, IEditorScope,
             IEditorValue, IEditorSchema, IDangerClassifier, AppSeverity. -->
        <PackageReference Include="Bennewitz.Ninja.ScopedEditors.Abstractions" Version="$(ScopedEditorsVersion)" />
        <!-- BytesToHumanReadableConverter.Format: the Backup page renders archive sizes with the
             formatter every other size in the apps uses.
             ⚠ Re-implementing it here instead would put a second byte-rounding rule in the
             codebase, and the two would drift in the decimal place nobody checks. -->
        <PackageReference Include="Bennewitz.Ninja.ScopedEditors.Avalonia" Version="$(ScopedEditorsVersion)" />
        <!-- The service contracts: IDialogService, IShareService, ShareOutcome, and ISaveChangesPrompt,
             the dialog-service seam the save view-model implements. -->
        <PackageReference Include="Bennewitz.Ninja.AppServices.Abstractions" Version="$(AppServicesVersion)" />
        <!-- ShellLauncher.Instance, for Reveal in file manager on the Backup page. The one reason
             this library depends on a concrete service rather than only its contract. -->
        <PackageReference Include="Bennewitz.Ninja.AppServices" Version="$(AppServicesVersion)" />
    </ItemGroup>

    <ItemGroup>
        <!-- Search matches against schema shapes: SchemaSearchResult (Sdk) is what a
             product's client hands back for a query, and SchemaNode (Core, pulled in
             transitively) is what a settings-group page exposes. Both are neutral
             AgentForge.* types describing a config schema, not a product. -->
        <ProjectReference Include="..\AgentForge.Sdk\AgentForge.Sdk.csproj" />
    </ItemGroup>

</Project>
