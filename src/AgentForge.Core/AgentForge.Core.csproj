<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <IsPackable>true</IsPackable>
        <RootNamespace>Bennewitz.Ninja.AgentForge.Core</RootNamespace>
        <AssemblyName>AgentForge.Core</AssemblyName>
        <Description>
            The product-neutral engines an agent-configuration app is built on: JSON Schema
            loading and validation with a network-first resolution chain and a disk cache,
            the layered settings workspace, the backup and restore engine, artifact profiles
            and the model catalog, platform path resolution, and the update check.

            Knows about no agent. Every product-shaped answer — which files, which scopes,
            which schema — arrives as a descriptor from the host.

            Invariant: AgentForge.* must never reference ClaudeForge.* or OpenCode.*.
            AssemblyLayeringTests enforces it.
        </Description>
    </PropertyGroup>

    <!-- The solution's friend grants, in one shared file next to the .slnx. LINKED, not
         copied, by a relative path with forward slashes so Linux and macOS resolve it the
         same way Windows does. Read that file before adding a name: it is compiled into
         every assembly, so a grant there applies to all of them. -->
    <ItemGroup>
        <Compile Include="../../AssemblyInfo.InternalsVisibleTo.cs" Link="Properties/AssemblyInfo.InternalsVisibleTo.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JsonSchema.Net" Version="9.2.2" />
        <!-- Serilog: structured logging for fallback/degraded-mode paths (cache misses,
             file discovery errors).  No Avalonia dependency — safe to reference from Core. -->
        <PackageReference Include="Serilog" Version="4.3.1" />
        <!-- The comment-preserving JSONC reader and writer, from its own repository
             (JanusMael/Bennewitz.Ninja.JsonC) on nuget.org since plans/00007. A package in
             every mode: it is not one of this repository's shared projects, so the
             UseSharedPackages switch never sees it. The version is the root props' pin. -->
        <PackageReference Include="Bennewitz.Ninja.JsonC" Version="$(JsonCVersion)" />
    </ItemGroup>

    <ItemGroup>
        <!-- The neutral IConfigWriter contract the JSONC writer and the legacy writer both
             implement. -->
        <ProjectReference Include="..\AgentForge.Abstractions\AgentForge.Abstractions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Assets\Schemas\**\*.json"/>
        <EmbeddedResource Include="Assets\ModelCatalog\**\*.json"/>
        <EmbeddedResource Include="Assets\Descriptions\**\*.json"/>
    </ItemGroup>

</Project>
