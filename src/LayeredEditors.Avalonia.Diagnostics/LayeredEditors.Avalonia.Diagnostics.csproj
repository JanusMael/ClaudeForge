<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <IsPackable>true</IsPackable>
        <RootNamespace>Bennewitz.Ninja.LayeredEditors.Avalonia.Diagnostics</RootNamespace>
        <AssemblyName>LayeredEditors.Avalonia.Diagnostics</AssemblyName>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- Generate XML doc in all configurations for IDE IntelliSense and NuGet packaging.
             The publish script excludes *.xml from the distribution zip so the doc file
             does not appear in user-facing archives. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591: Missing XML comment for publicly visible type or member.
             Enabled selectively: we want public API documented for the future NuGet
             package, but internal test seams don't need doc comments. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <Description>
            Production-ready logging and diagnostics infrastructure for Avalonia apps:
            Serilog bridge for Avalonia's internal logger, bucketed rolling file sink,
            floating F12 live-log window, extensibility-friendly replacement for the
            built-in ExceptionValidationPlugin, and a DataValidationErrors attached-property
            logger that catches binding errors Avalonia's own logger never sees.
        </Description>
        <!-- Identity, authors, licence, repository and readme now come from
             src/Directory.Build.props, which covers all eleven packages. The placeholders
             that used to sit here named this package WITHOUT the Bennewitz.Ninja prefix and
             credited "LayeredEditors contributors"; both would have shipped on first publish.
             Tags stay, because they are the one piece of this metadata that is genuinely
             per-package. -->
        <PackageTags>avalonia;serilog;logging;diagnostics;binding;crash</PackageTags>
    </PropertyGroup>

    <!-- The solution's friend grants, in one shared file next to the .slnx. LINKED, not
         copied, by a relative path with forward slashes so Linux and macOS resolve it the
         same way Windows does. Read that file before adding a name: it is compiled into
         every assembly, so a grant there applies to all of them. -->
    <ItemGroup>
        <Compile Include="../../AssemblyInfo.InternalsVisibleTo.cs" Link="Properties/AssemblyInfo.InternalsVisibleTo.cs"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Core Avalonia runtime. -->
        <PackageReference Include="Avalonia" Version="12.1.3" />

        <!-- Serilog pipeline. PrivateAssets="" lets these flow transitively to
             consuming apps, so a consumer that only references this project still
             gets Serilog symbols. Pinned to trim-annotated, reflection-free versions
             (no Serilog.Settings.Configuration — that one is not trim-safe). -->
        <PackageReference Include="Serilog" Version="4.3.1" PrivateAssets="" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" PrivateAssets="" />
        <PackageReference Include="Serilog.Sinks.Trace" Version="4.0.0" PrivateAssets=""/>
    </ItemGroup>

    <!-- Expose internal test-seam members (Map, BucketStart/FileName, etc.) to the
         matching test project without making them part of the public API. -->
    <ItemGroup>
    </ItemGroup>

    <!-- This project's own README.md is still the one that ships: src/Directory.Build.props
         packs a project-local README.md when there is one and the shared PACKAGE-README.md
         otherwise, so the include that used to sit here is now redundant rather than removed. -->
</Project>
