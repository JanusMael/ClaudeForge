<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!--
          This sample exists to prove the SDK is Avalonia-free and headless-consumable.
          It deliberately references ONLY the two SDK assemblies — AgentForge.Sdk for
          the product-neutral surface and ClaudeForge.Sdk.Claude for the Claude
          accessors. If a future change accidentally pulls Avalonia into either one's
          transitive reference closure, this project starts failing to build with
          package-version conflicts long before the GUI does.
        -->
        <IsPackable>false</IsPackable>
        <PackageId>ClaudeForge.Samples.McpServer</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\AgentForge.Sdk\AgentForge.Sdk.csproj"/>
        <ProjectReference Include="..\..\src\ClaudeForge.Sdk.Claude\ClaudeForge.Sdk.Claude.csproj"/>
    </ItemGroup>
</Project>
